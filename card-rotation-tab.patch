index 0000000..ffec0c9
--- /dev/null
+++ b/app/src/main/java/com/pennywiseai/tracker/domain/rotation/CardRotation.kt
@@ -0,0 +1,390 @@
+package com.pennywiseai.tracker.domain.rotation
+
+import java.math.BigDecimal
+import java.math.RoundingMode
+import java.time.Duration
+import java.time.LocalDateTime
+
+/**
+ * Card rotation: spend on a credit card through a payment gateway (Cashfree,
+ * Razorpay, ...) so that the money lands in your own bank account, minus a fee.
+ *
+ *   card purchase  ₹50,584.10  (merchant "Cas*..." )
+ *   bank credit    ₹50,000.00  ("Cashfree Payments in your a/c")
+ *   charges        ₹   584.10  (0.99% + 18% GST)
+ *
+ * That is neither income nor an expense: only the charges are a real cost. This
+ * file is deliberately free of Android / Room types so it can be unit-tested on
+ * the JVM; the ViewModel maps TransactionEntity -> [RotationTxn].
+ */
+
+enum class RotationKind {
+    /** Purchase on a credit card (TransactionType.CREDIT). */
+    CARD_PURCHASE,
+
+    /** Money received in an account (TransactionType.INCOME). */
+    INCOMING,
+
+    /** Money leaving a bank account (TransactionType.EXPENSE). */
+    OUTGOING,
+
+    /** Anything else; ignored. */
+    OTHER,
+}
+
+data class RotationTxn(
+    val id: Long,
+    val amount: BigDecimal,
+    val merchant: String,
+    val kind: RotationKind,
+    val dateTime: LocalDateTime,
+    val bankName: String? = null,
+    val account: String? = null,
+    /** Free text used to find a card's last 4 digits in a bill-payment debit. */
+    val text: String = "",
+)
+
+data class CardKey(val bank: String, val last4: String) {
+    val label: String get() = if (last4.isBlank()) bank else "$bank ••$last4"
+}
+
+/** What the money was used for when the bank credit SMS is missing. */
+enum class OnwardUse {
+    /** Paid to another card / own account: neither leg is spending. */
+    TRANSFER,
+
+    /** A real expense (rent, a bill...): only the card leg is a rotation, the debit stays an expense. */
+    EXPENSE,
+}
+
+/** User-confirmed link between a card purchase and the bank debit that followed it (credit SMS missing). */
+data class ManualLink(val outId: Long, val onwardId: Long, val use: OnwardUse)
+
+data class RotationPair(
+    val outId: Long,
+    val inId: Long,
+    val card: CardKey,
+    val spent: BigDecimal,
+    val received: BigDecimal,
+    val charges: BigDecimal,
+    val at: LocalDateTime,
+    /** True when the bank credit is missing and [inId] is the later debit; charges are then an estimate. */
+    val inferred: Boolean = false,
+    /** Whether the second row is excluded from totals (false for an inferred link whose debit is a real expense). */
+    val excludeIn: Boolean = true,
+    /**
+     * The bank debit that spent the credit, usually paying another card's bill. It is the third leg of the loop:
+     * left counted it would show the same money as an expense a second time.
+     */
+    val onwardId: Long? = null,
+)
+
+/** A card spend with no credit and no plausible onward debit: the app asks "was a credit missed?". */
+data class UnmatchedSpend(
+    val outId: Long,
+    val card: CardKey,
+    val merchant: String,
+    val spent: BigDecimal,
+    val at: LocalDateTime,
+)
+
+/** An unconfirmed guess: card purchase followed by a bank debit of nearly the same amount. */
+data class RotationSuggestion(
+    val outId: Long,
+    val onwardId: Long,
+    val card: CardKey,
+    val spent: BigDecimal,
+    val onward: BigDecimal,
+    val estCharges: BigDecimal,
+    val at: LocalDateTime,
+    val onwardAt: LocalDateTime,
+    /** The debit text looks like a credit-card bill payment, so TRANSFER is the likely answer. */
+    val looksLikeCardBill: Boolean,
+)
+
+data class CardLedger(
+    val card: CardKey,
+    val rotations: List<RotationPair>,
+    val rotated: BigDecimal,
+    val received: BigDecimal,
+    val charges: BigDecimal,
+    /** charges as a percentage of the amount received (e.g. 1.17). */
+    val chargePct: BigDecimal,
+    /** Bank-side card-bill payments assigned to this card since its first rotation. */
+    val repaid: BigDecimal,
+    /** rotated - repaid, never below zero. An estimate: repayments also settle normal spends. */
+    val stillToRepay: BigDecimal,
+    val repaymentIds: List<Long>,
+    /** True when at least one rotation is inferred, so received/charges are estimates. */
+    val hasEstimates: Boolean = false,
+)
+
+data class RotationReport(
+    val cards: List<CardLedger>,
+    val suggestions: List<RotationSuggestion> = emptyList(),
+    /** Card spends to ask the user about (no credit found, not dismissed). */
+    val needsCredit: List<UnmatchedSpend> = emptyList(),
+    /** Card-bill payments we could not tie to a specific card. */
+    val unassignedRepaymentIds: List<Long>,
+    val unassignedRepaid: BigDecimal,
+) {
+    val totalRotated: BigDecimal get() = cards.fold(BigDecimal.ZERO) { a, c -> a + c.rotated }
+    val totalReceived: BigDecimal get() = cards.fold(BigDecimal.ZERO) { a, c -> a + c.received }
+    val totalCharges: BigDecimal get() = cards.fold(BigDecimal.ZERO) { a, c -> a + c.charges }
+
+    /** Ids of every row that must be excluded from income/expense totals because of a rotation. */
+    val pairedIds: Set<Long>
+        get() = cards.flatMap { c ->
+            c.rotations.flatMap { p -> listOfNotNull(p.outId, p.inId.takeIf { p.excludeIn }, p.onwardId) }
+        }.toSet()
+}
+
+object CardRotation {
+
+    /** Merchant name given to the credit row the user enters by hand; it also counts as a gateway marker. */
+    const val MANUAL_CREDIT_MERCHANT = "Card rotation credit"
+
+    /** The note the app writes on a hand-entered credit: names the card spend it belongs to. */
+    private val BOUND_SPEND = Regex("card spend #(\\d+)", RegexOption.IGNORE_CASE)
+
+    /** Gateway markers, matched case-insensitively. `\b` keeps "cred" out of "credit"/"credited". */
+    val DEFAULT_GATEWAYS: List<Regex> = listOf(
+        "^cas\\*", "\\bcashfree\\b", "\\brazorpay\\b", "^razp\\*", "\\bpayu\\b", "\\bbilldesk\\b",
+        "\\bpaytm\\b", "\\bphonepe\\b", "\\bcred\\b", "\\bmobikwik\\b", "\\bfreecharge\\b",
+        "\\bjuspay\\b", "\\bcard rotation\\b", "\\bccavenue\\b", "\\binstamojo\\b", "\\beasebuzz\\b", "\\bcashgram\\b",
+    ).map { Regex(it, RegexOption.IGNORE_CASE) }
+
+    /** Words that mark a bank debit as a credit-card bill payment. */
+    val CARD_BILL_WORDS: Regex =
+        Regex("credit\\s*card|\\bcc\\s*(bill|payment)|card\\s*(bill|payment|dues)|\\bcred\\b", RegexOption.IGNORE_CASE)
+
+    fun analyze(
+        txns: List<RotationTxn>,
+        gateways: List<Regex> = DEFAULT_GATEWAYS,
+        windowMinutes: Long = 48L * 60L,
+        maxChargePct: BigDecimal = BigDecimal("5"),
+        links: List<ManualLink> = emptyList(),
+        dismissedOutIds: Set<Long> = emptySet(),
+        suggestWindowMinutes: Long = 12L * 60L,
+        onwardWindowMinutes: Long = 48L * 60L,
+        askMinAmount: BigDecimal = BigDecimal.ZERO,
+        askWithinDays: Long = 60L,
+        asOf: LocalDateTime = LocalDateTime.now(),
+    ): RotationReport {
+        val incomingTl = Timeline(txns.filter { it.kind == RotationKind.INCOMING })
+        val outgoingTl = Timeline(txns.filter { it.kind == RotationKind.OUTGOING })
+        val byId = txns.associateBy { it.id }
+        val claimed = HashSet<Long>()
+        val pairs = ArrayList<RotationPair>()
+
+        fun isGateway(s: String) = gateways.any { it.containsMatchIn(s.trim()) }
+        // Each row's gateway-ness never changes, so test the regexes once per row instead of once per candidate.
+        val rowGateway = HashMap<Long, Boolean>()
+        fun rowIsGateway(t: RotationTxn) = rowGateway.getOrPut(t.id) { isGateway(t.merchant) || isGateway(t.text) }
+
+        // A credit the user typed in is tied to the exact card spend it was entered for (the app writes
+        // "card spend #<id>" into its note). Matching it by amount and time instead let it be taken by an
+        // earlier spend of similar size, leaving the real one "missing".
+        val boundOut = HashSet<Long>()
+        for (c in txns.filter { it.kind == RotationKind.INCOMING && isManualCredit(it) }) {
+            val targetId = BOUND_SPEND.find(c.text)?.groupValues?.get(1)?.toLongOrNull() ?: continue
+            val out = byId[targetId]
+                ?.takeIf { it.kind == RotationKind.CARD_PURCHASE && it.id !in boundOut && c.amount.signum() > 0 && c.amount <= it.amount }
+                ?: continue
+            boundOut += out.id
+            claimed += c.id
+            pairs += RotationPair(
+                outId = out.id, inId = c.id, card = cardKey(out),
+                spent = out.amount, received = c.amount, charges = out.amount - c.amount, at = out.dateTime,
+            )
+        }
+
+        for (out in txns.filter { it.kind == RotationKind.CARD_PURCHASE && it.id !in boundOut }.sortedBy { it.dateTime }) {
+            val window = Duration.ofMinutes(windowMinutes)
+            val outIsGateway = isGateway(out.merchant)
+            // charge% <= max  <=>  received >= spent * 100 / (100 + max); one division per spend, not per candidate
+            val minReceived = out.amount.multiply(BigDecimal(100)).divide(BigDecimal(100).add(maxChargePct), 4, RoundingMode.CEILING)
+            val best = incomingTl.between(out.dateTime.minus(window), out.dateTime.plus(window))
+                .asSequence()
+                .filter { it.id !in claimed && !isManualCredit(it) }
+                .filter { it.amount.signum() > 0 && it.amount <= out.amount }
+                .filter { it.amount >= minReceived }
+                .filter { sameAccountNotAllowed(out, it) }
+                .filter { Duration.between(out.dateTime, it.dateTime).abs().toMinutes() <= windowMinutes }
+                // a rotation needs a gateway on at least one side; plain coincidences stay as they are
+                .filter { outIsGateway || rowIsGateway(it) }
+                .minByOrNull { Duration.between(out.dateTime, it.dateTime).abs().toMinutes() }
+                ?: continue
+            claimed += best.id
+            pairs += RotationPair(
+                outId = out.id,
+                inId = best.id,
+                card = cardKey(out),
+                spent = out.amount,
+                received = best.amount,
+                charges = out.amount - best.amount,
+                at = out.dateTime,
+            )
+        }
+
+        // Third leg: the bank debit that spent the credit (e.g. paying another card's bill).
+        val usedOnward = HashSet<Long>()
+        val withOnward = pairs.map { p ->
+            val credit = byId[p.inId] ?: return@map p
+            val floor = credit.amount.multiply(BigDecimal("0.90"))
+            val onward = outgoingTl
+                .between(credit.dateTime.minusMinutes(5), credit.dateTime.plusMinutes(onwardWindowMinutes))
+                .asSequence()
+                .filter { it.id !in usedOnward && it.amount <= credit.amount && it.amount >= floor }
+                .filter { accountsCompatible(credit, it) }
+                // only debits that look like paying a card (or going through a bill-pay gateway)
+                .filter { looksLikeCardBill(it) || isGateway(it.merchant) }
+                .minByOrNull { Duration.between(credit.dateTime, it.dateTime).abs().toMinutes() }
+            if (onward == null) p else { usedOnward += onward.id; p.copy(onwardId = onward.id) }
+        }
+        pairs.clear()
+        pairs.addAll(withOnward)
+
+        // Credit SMS missing: the user confirmed "this card spend was followed by this debit".
+        val usedOut = pairs.map { it.outId }.toMutableSet()
+        for (l in links) {
+            val out = byId[l.outId]?.takeIf { it.kind == RotationKind.CARD_PURCHASE && it.id !in usedOut } ?: continue
+            val onward = byId[l.onwardId]?.takeIf { it.kind == RotationKind.OUTGOING && it.id !in claimed && it.id !in usedOnward } ?: continue
+            val diff = (out.amount - onward.amount).max(BigDecimal.ZERO)
+            usedOut += out.id
+            usedOnward += onward.id
+            pairs += RotationPair(
+                outId = out.id, inId = onward.id, card = cardKey(out),
+                spent = out.amount, received = onward.amount.min(out.amount), charges = diff, at = out.dateTime,
+                inferred = true, excludeIn = l.use == OnwardUse.TRANSFER,
+            )
+        }
+
+        val suggestions = ArrayList<RotationSuggestion>()
+        val suggestedOnward = HashSet<Long>()
+        for (out in txns.filter { it.kind == RotationKind.CARD_PURCHASE }.sortedBy { it.dateTime }) {
+            if (out.id in usedOut || out.id in dismissedOutIds) continue
+            val minDebit = out.amount.multiply(BigDecimal(100)).divide(BigDecimal(100).add(maxChargePct), 4, RoundingMode.CEILING)
+            val onward = outgoingTl
+                .between(out.dateTime.minusMinutes(5), out.dateTime.plusMinutes(suggestWindowMinutes))
+                .asSequence()
+                .filter { it.id !in claimed && it.id !in usedOnward && it.id !in suggestedOnward }
+                .filter { it.amount.signum() > 0 && it.amount <= out.amount && it.amount >= minDebit }
+                // the debit follows the card spend (5 min of SMS clock skew allowed)
+                .filter { !it.dateTime.isBefore(out.dateTime.minusMinutes(5)) }
+                .filter { Duration.between(out.dateTime, it.dateTime).toMinutes() <= suggestWindowMinutes }
+                .minByOrNull { Duration.between(out.dateTime, it.dateTime).abs().toMinutes() }
+                ?: continue
+            suggestedOnward += onward.id
+            suggestions += RotationSuggestion(
+                outId = out.id, onwardId = onward.id, card = cardKey(out), spent = out.amount, onward = onward.amount,
+                estCharges = out.amount - onward.amount, at = out.dateTime, onwardAt = onward.dateTime,
+                looksLikeCardBill = looksLikeCardBill(onward),
+            )
+        }
+
+        val suggestedOut = suggestions.map { it.outId }.toSet()
+        val since = asOf.minusDays(askWithinDays)
+        val needsCredit = txns
+            .filter { it.kind == RotationKind.CARD_PURCHASE }
+            .filter { it.id !in usedOut && it.id !in suggestedOut && it.id !in dismissedOutIds }
+            .filter { it.amount >= askMinAmount && !it.dateTime.isBefore(since) }
+            .sortedByDescending { it.dateTime }
+            .map { UnmatchedSpend(it.id, cardKey(it), it.merchant, it.amount, it.dateTime) }
+
+        val cardKeys = pairs.map { it.card }.distinct()
+        val firstRotation = pairs.groupBy { it.card }.mapValues { (_, v) -> v.minOf { it.at } }
+
+        // Card-bill payments leave a bank account; the card-side "payment received" SMS is skipped by parsers.
+        val repayments = txns.filter { it.kind == RotationKind.OUTGOING && looksLikeCardBill(it) }
+        val assigned = HashMap<CardKey, MutableList<RotationTxn>>()
+        val unassigned = ArrayList<RotationTxn>()
+        for (r in repayments) {
+            val haystack = "${r.merchant} ${r.text}"
+            val card = cardKeys
+                .filter { it.last4.isNotBlank() && Regex("(?<!\\d)${it.last4}(?!\\d)").containsMatchIn(haystack) }
+                .singleOrNull()
+            if (card == null) unassigned += r else assigned.getOrPut(card) { ArrayList() } += r
+        }
+
+        val ledgers = pairs.groupBy { it.card }.map { (card, ps) ->
+            val rotated = ps.fold(BigDecimal.ZERO) { a, p -> a + p.spent }
+            val received = ps.fold(BigDecimal.ZERO) { a, p -> a + p.received }
+            val charges = rotated - received
+            val since = firstRotation.getValue(card)
+            val reps = assigned[card].orEmpty().filter { !it.dateTime.isBefore(since) }
+            val repaid = reps.fold(BigDecimal.ZERO) { a, r -> a + r.amount }
+            CardLedger(
+                card = card,
+                rotations = ps.sortedBy { it.at },
+                rotated = rotated,
+                received = received,
+                charges = charges,
+                chargePct = pct(charges, received),
+                repaid = repaid,
+                stillToRepay = (rotated - repaid).max(BigDecimal.ZERO),
+                repaymentIds = reps.map { it.id },
+                hasEstimates = ps.any { it.inferred },
+            )
+        }.sortedByDescending { it.rotated }
+
+        return RotationReport(
+            cards = ledgers,
+            suggestions = suggestions,
+            needsCredit = needsCredit,
+            unassignedRepaymentIds = unassigned.map { it.id },
+            unassignedRepaid = unassigned.fold(BigDecimal.ZERO) { a, r -> a + r.amount },
+        )
+    }
+
+    /** Same bank and last 4 on both rows is the *same* account; unknown accounts are compatible. */
+    private fun accountsCompatible(a: RotationTxn, b: RotationTxn): Boolean {
+        val x = digits(a.account).takeLast(4)
+        val y = digits(b.account).takeLast(4)
+        return x.isEmpty() || y.isEmpty() || (x == y && a.bankName.equals(b.bankName, ignoreCase = true))
+    }
+
+    /** Rows sorted by time with binary-search range lookup, so matching stays fast with thousands of rows. */
+    private class Timeline(rows: List<RotationTxn>) {
+        private val sorted = rows.sortedBy { it.dateTime }
+        private val times = sorted.map { it.dateTime }
+
+        fun between(from: LocalDateTime, to: LocalDateTime): List<RotationTxn> {
+            var i = lowerBound(from)
+            val out = ArrayList<RotationTxn>()
+            while (i < sorted.size && !times[i].isAfter(to)) { out += sorted[i]; i++ }
+            return out
+        }
+
+        private fun lowerBound(t: LocalDateTime): Int {
+            var lo = 0
+            var hi = times.size
+            while (lo < hi) {
+                val mid = (lo + hi) ushr 1
+                if (times[mid].isBefore(t)) lo = mid + 1 else hi = mid
+            }
+            return lo
+        }
+    }
+
+    private fun isManualCredit(t: RotationTxn) = t.merchant.equals(MANUAL_CREDIT_MERCHANT, ignoreCase = true)
+
+    private fun looksLikeCardBill(t: RotationTxn) = CARD_BILL_WORDS.containsMatchIn("${t.merchant} ${t.text}")
+
+    private fun digits(s: String?) = s.orEmpty().filter { it.isDigit() }
+
+    private fun cardKey(t: RotationTxn) = CardKey(t.bankName?.takeIf { it.isNotBlank() } ?: "Card", digits(t.account).takeLast(4))
+
+    /** A rotation moves money to a *different* account; unknown accounts are allowed (like the transfer detector). */
+    private fun sameAccountNotAllowed(a: RotationTxn, b: RotationTxn): Boolean {
+        val x = digits(a.account).takeLast(4)
+        val y = digits(b.account).takeLast(4)
+        return x.isEmpty() || y.isEmpty() || x != y || !a.bankName.equals(b.bankName, ignoreCase = true)
+    }
+
+    private fun chargePct(spent: BigDecimal, received: BigDecimal) = pct(spent - received, received)
+
+    private fun pct(part: BigDecimal, whole: BigDecimal): BigDecimal =
+        if (whole.signum() == 0) BigDecimal.ZERO
+        else part.multiply(BigDecimal(100)).divide(whole, 2, RoundingMode.HALF_UP)
+}
