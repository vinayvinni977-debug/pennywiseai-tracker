+import com.pennywiseai.tracker.domain.rotation.CardRotation
+import com.pennywiseai.tracker.domain.rotation.DashboardReport
+import dagger.hilt.android.lifecycle.HiltViewModel
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.FlowPreview
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.combine
+import kotlinx.coroutines.flow.debounce
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import javax.inject.Inject
+
+data class CreditCardsUiState(
+    val report: DashboardReport? = null,
+    val isLoading: Boolean = true,
+)
+
+/** Per-card spend / paid / outstanding / rotation dashboard. Reads only; it never changes transactions. */
+@OptIn(FlowPreview::class)
+@HiltViewModel
+class CreditCardsViewModel @Inject constructor(
+    private val transactionRepository: TransactionRepository,
+    private val accountBalanceRepository: AccountBalanceRepository,
+    @ApplicationContext context: Context,
+) : ViewModel() {
+
+    private val store = CardRotationStore(context)
+    private val assignments = MutableStateFlow(store.assignments())
+    private val _uiState = MutableStateFlow(CreditCardsUiState())
+    val uiState: StateFlow<CreditCardsUiState> = _uiState.asStateFlow()
+
+    init {
+        viewModelScope.launch {
+            combine(transactionRepository.getAllTransactions(), accountBalanceRepository.getAllLatestBalances(), assignments) { tx, acc, a -> Triple(tx, acc, a) }
+                .debounce(300)
+                .collect { (tx, acc, assigned) ->
+                    val rows = tx.filter { !it.isDeleted && it.currency == "INR" }
+                    val report = withContext(Dispatchers.Default) {
+                        val txns = rows.mapNotNull { it.toRotationTxn() }
+                        val rotation = CardRotation.analyze(txns, links = store.links(), dismissedOutIds = store.dismissed())
+                        val cards = acc.filter { it.isCreditCard }
+                            .map { CardAccount(it.bankName, it.accountLast4, it.balance, it.creditLimit) }
+                        CardDashboard.build(txns, cards, rotation, assignments = assigned)
+                    }
+                    _uiState.value = CreditCardsUiState(report = report, isLoading = false)
+                }
+        }
+    }
+
+    /** Tie a card-bill payment (e.g. "CRED Club") to the card it paid, so that card's "Paid" is right. */
+    fun assignPayment(paymentId: Long, card: CardKey) {
+        val next = assignments.value + (paymentId to card)
+        store.saveAssignments(next)
+        assignments.value = next
+    }
+}
