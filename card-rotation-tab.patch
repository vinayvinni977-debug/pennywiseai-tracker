+
+private val inr: NumberFormat = NumberFormat.getCurrencyInstance(Locale.Builder().setLanguage("en").setRegion("IN").build())
+private val whenFmt: DateTimeFormatter = DateTimeFormatter.ofPattern("d MMM, h:mm a")
+private val dateFmt: DateTimeFormatter = DateTimeFormatter.ofPattern("d MMM yyyy")
+private fun money(v: BigDecimal): String = inr.format(v)
+
+private fun evidenceLabel(e: PaymentEvidence?): String = when (e) {
+    PaymentEvidence.CRED -> "CRED payment. Always asks which card you paid."
+    PaymentEvidence.HDFC_NETBANKING -> "Looks like an HDFC NetBanking card payment."
+    PaymentEvidence.CARD_WORDS -> "Mentions a card payment but not which card."
+    PaymentEvidence.CARD_LAST4 -> "The SMS names the card."
+    PaymentEvidence.USER_MARKED -> "Marked by you."
+    null -> ""
+}
+
+private fun statusLabel(s: PaymentStatus): String = when (s) {
+    PaymentStatus.PENDING -> "Waiting"
+    PaymentStatus.CONFIRMED -> "Confirmed"
+    PaymentStatus.FAILED -> "Failed"
+    PaymentStatus.REVERSED -> "Reversed"
+    PaymentStatus.DUPLICATE -> "Duplicate"
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun CardPaymentsScreen(
+    onNavigateBack: () -> Unit,
+    viewModel: CardPaymentsViewModel = hiltViewModel(),
+) {
+    val state by viewModel.uiState.collectAsStateWithLifecycle()
+    val report = state.report
+    val context = LocalContext.current
+    LaunchedEffect(Unit) { viewModel.messages.collect { Toast.makeText(context, it, Toast.LENGTH_LONG).show() } }
+
+    var confirming by remember { mutableStateOf<PaymentRow?>(null) }
+    var reconciling by remember { mutableStateOf<CardPaymentSummary?>(null) }
+    var scheduling by remember { mutableStateOf<CardPaymentSummary?>(null) }
+    var pickingMissed by remember { mutableStateOf(false) }
+    var expanded by remember { mutableStateOf(setOf<String>()) }
+
+    confirming?.let { row ->
+        ConfirmPaymentDialog(
+            row = row, report = report,
+            preview = { card, amount -> viewModel.preview(row.txn, card, amount) },
+            onConfirm = { card, amount -> viewModel.confirm(row.txn, card, amount); confirming = null },
+            onDismiss = { confirming = null },
+        )
+    }
+    reconciling?.let { s ->
+        ReconcileDialog(s, onSave = { viewModel.reconcile(s.card, it); reconciling = null }, onDismiss = { reconciling = null })
+    }
+    scheduling?.let { s ->
+        ScheduleDialog(s, onSave = { viewModel.saveSchedule(it); scheduling = null }, onDismiss = { scheduling = null })
+    }
+    if (pickingMissed) {
+        AlertDialog(
+            onDismissRequest = { pickingMissed = false },
+            title = { Text("Which bank debit was a card payment?") },
+            text = {
+                LazyColumn(verticalArrangement = Arrangement.spacedBy(6.dp)) {
+                    if (state.recentDebits.isEmpty()) item { Text("No recent bank debits found.") }
+                    items(state.recentDebits, key = { "m-${it.id}" }) { t ->
+                        Column(Modifier.fillMaxWidth().clickable {
+                            pickingMissed = false
+                            confirming = PaymentRow(t, PaymentStatus.PENDING, null, null, PaymentEvidence.USER_MARKED, PaymentRow.Basis.NONE, "", emptyList(), null)
+                        }.padding(vertical = 4.dp)) {
+                            Text("${money(t.amount)} · ${t.merchant}", style = MaterialTheme.typography.bodyMedium, maxLines = 1)
+                            Text(t.dateTime.format(whenFmt), style = MaterialTheme.typography.bodySmall)
+                        }
+                        HorizontalDivider()
+                    }
+                }
+            },
+            confirmButton = {},
+            dismissButton = { TextButton(onClick = { pickingMissed = false }) { Text("Cancel") } },
+        )
+    }
+
+    Scaffold(
+        topBar = {
+            TopAppBar(
+                title = { Text("Card payments") },
+                navigationIcon = { IconButton(onClick = onNavigateBack) { Icon(Icons.AutoMirrored.Filled.ArrowBack, contentDescription = "Back") } },
+            )
+        },
+    ) { padding ->
+        LazyColumn(
+            modifier = Modifier.padding(padding),
+            contentPadding = PaddingValues(16.dp),
+            verticalArrangement = Arrangement.spacedBy(12.dp),
+        ) {
+            if (report == null) {
+                item { Text(if (state.isLoading) "Loading…" else "Nothing to show yet.") }
+                return@LazyColumn
+            }
+            item {
+                Card(Modifier.fillMaxWidth()) {
+                    Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+                        Text("Confirmed card payments this month", style = MaterialTheme.typography.titleMedium, fontWeight = FontWeight.SemiBold)
+                        Text(money(report.confirmedThisMonth), style = MaterialTheme.typography.headlineSmall)
+                        Text(
+                            "Only confirmed payments reduce a card's outstanding amount. Waiting, failed, reversed and duplicate payments never do.",
+                            style = MaterialTheme.typography.bodySmall,
+                        )
+                        OutlinedButton(onClick = { pickingMissed = true }) { Text("A card payment was missed") }
+                    }
+                }
+            }
+            if (report.pending.isNotEmpty()) {
+                item { Text("Waiting for your answer (${report.pending.size})", style = MaterialTheme.typography.titleMedium, fontWeight = FontWeight.SemiBold) }
+                items(report.pending, key = { "p-${it.txn.id}" }) { row ->
+                    Card(Modifier.fillMaxWidth()) {
+                        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(4.dp)) {
+                            Text("${money(row.txn.amount)} · ${row.txn.merchant}", style = MaterialTheme.typography.bodyLarge, fontWeight = FontWeight.SemiBold, maxLines = 1)
+                            Text("${row.txn.dateTime.format(whenFmt)} · ${row.txn.bankName.orEmpty()}", style = MaterialTheme.typography.bodySmall)
+                            Text(evidenceLabel(row.evidence), style = MaterialTheme.typography.bodySmall)
+                            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                                Button(onClick = { confirming = row }) { Text("Choose card") }
+                                OutlinedButton(onClick = { viewModel.notACardPayment(row.txn.id) }) { Text("Not a card payment") }
+                            }
+                        }
+                    }
+                }
+            }
+            if (report.questions.isNotEmpty()) {
+                item { Text("Please check (${report.questions.size})", style = MaterialTheme.typography.titleMedium, fontWeight = FontWeight.SemiBold) }
+                items(report.questions, key = { "q-${questionKey(it)}" }) { q ->
+                    QuestionCard(q, report, onDuplicate = { viewModel.flagDuplicate(q.txnId) }, onKeep = { viewModel.answerQuestion(q) },
+                        onReverse = { viewModel.markStatus(q.txnId, PaymentStatus.REVERSED, "Reversed after your check") })
+                }
+            }
+            item { Text("Cards", style = MaterialTheme.typography.titleMedium, fontWeight = FontWeight.SemiBold) }
+            if (report.cards.isEmpty()) item { Text("No cards found yet. They appear once PennyWise reads a card SMS.", style = MaterialTheme.typography.bodyMedium) }
+            items(report.cards, key = { "c-${CardPayments.id(it.card)}" }) { c ->
+                val open = CardPayments.id(c.card) in expanded
+                CardPaymentsBlock(
+                    c = c, open = open,
+                    onToggle = { val k = CardPayments.id(c.card); expanded = if (open) expanded - k else expanded + k },
+                    onReconcile = { reconciling = c }, onSchedule = { scheduling = c },
+                    onUnassign = { viewModel.unassign(it) },
+                )
+            }
+        }
+    }
+}
