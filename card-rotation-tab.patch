@@ -0,0 +1,85 @@
+package com.pennywiseai.tracker.presentation.rotation
+
+import android.content.Context
+import com.pennywiseai.tracker.domain.rotation.CardKey
+import com.pennywiseai.tracker.domain.rotation.ManualLink
+import com.pennywiseai.tracker.domain.rotation.OnwardUse
+
+/**
+ * Small SharedPreferences-backed store shared by the Card rotation screen and the reminder worker, so this
+ * feature needs no Room migration. Not part of the app's backup: reinstalling clears it.
+ *
+ * Link format: "outId:onwardId:T|E". Dismissed / notified: sets of card-spend transaction ids.
+ */
+class CardRotationStore(context: Context) {
+    private val prefs = context.applicationContext.getSharedPreferences(NAME, Context.MODE_PRIVATE)
+
+    fun links(): List<ManualLink> =
+        prefs.getStringSet(KEY_LINKS, emptySet()).orEmpty().mapNotNull { raw ->
+            val p = raw.split(":")
+            val out = p.getOrNull(0)?.toLongOrNull() ?: return@mapNotNull null
+            val onward = p.getOrNull(1)?.toLongOrNull() ?: return@mapNotNull null
+            ManualLink(out, onward, if (p.getOrNull(2) == "E") OnwardUse.EXPENSE else OnwardUse.TRANSFER)
+        }
+
+    fun saveLinks(v: List<ManualLink>) {
+        prefs.edit().putStringSet(
+            KEY_LINKS,
+            v.map { "${it.outId}:${it.onwardId}:${if (it.use == OnwardUse.TRANSFER) "T" else "E"}" }.toSet(),
+        ).apply()
+    }
+
+    fun dismissed(): Set<Long> = longs(KEY_DISMISSED)
+
+    fun saveDismissed(v: Set<Long>) {
+        prefs.edit().putStringSet(KEY_DISMISSED, v.map { it.toString() }.toSet()).apply()
+    }
+
+    /** Spends the user was already reminded about, so each one is announced once. */
+    fun notified(): Set<Long> = longs(KEY_NOTIFIED)
+
+    fun addNotified(ids: Collection<Long>) {
+        // Keep the newest few hundred so the set cannot grow forever.
+        val merged = (notified() + ids).toList().takeLast(MAX_NOTIFIED)
+        prefs.edit().putStringSet(KEY_NOTIFIED, merged.map { it.toString() }.toSet()).apply()
+    }
+
+    /** "Remind me about card spends with no credit"; on by default. */
+    var remindersEnabled: Boolean
+        get() = prefs.getBoolean(KEY_REMIND, true)
+        set(value) { prefs.edit().putBoolean(KEY_REMIND, value).apply() }
+
+    /** Smallest card spend the app asks "was a credit missed?" about. 0 means every spend. */
+    var askMinAmount: Int
+        get() = prefs.getInt(KEY_ASK_MIN, DEFAULT_ASK_MIN)
+        set(value) { prefs.edit().putInt(KEY_ASK_MIN, value.coerceAtLeast(0)).apply() }
+
+    /** Card-bill payments the user tied to a card by hand (CRED / UPI payments carry no card digits). */
+    fun assignments(): Map<Long, CardKey> =
+        prefs.getStringSet(KEY_ASSIGN, emptySet()).orEmpty().mapNotNull { raw ->
+            val p = raw.split("|", limit = 3)
+            val id = p.getOrNull(0)?.toLongOrNull() ?: return@mapNotNull null
+            val bank = p.getOrNull(1) ?: return@mapNotNull null
+            val last4 = p.getOrNull(2) ?: return@mapNotNull null
+            id to CardKey(bank, last4)
+        }.toMap()
+
+    fun saveAssignments(v: Map<Long, CardKey>) {
+        prefs.edit().putStringSet(KEY_ASSIGN, v.map { (id, c) -> "$id|${c.bank}|${c.last4}" }.toSet()).apply()
+    }
+
+    private fun longs(key: String): Set<Long> =
+        prefs.getStringSet(key, emptySet()).orEmpty().mapNotNull { it.toLongOrNull() }.toSet()
+
+    private companion object {
+        const val NAME = "card_rotation"
+        const val KEY_LINKS = "links"
+        const val KEY_DISMISSED = "dismissed"
+        const val KEY_NOTIFIED = "notified"
+        const val KEY_REMIND = "reminders"
+        const val KEY_ASK_MIN = "ask_min"
+        const val KEY_ASSIGN = "assign"
+        const val DEFAULT_ASK_MIN = 5000
+        const val MAX_NOTIFIED = 500
+    }
+}
