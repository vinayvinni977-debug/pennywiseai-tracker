+package com.pennywiseai.tracker.domain.rotation
+
+import java.math.BigDecimal
+import java.time.Duration
+import java.time.LocalDateTime
+
+/** One card spend the user should be asked about. */
+data class ReminderItem(
+    val outId: Long,
+    val cardLabel: String,
+    val spent: BigDecimal,
+    val at: LocalDateTime,
+)
+
+/**
+ * Decides which card spends deserve a "was a credit missed?" notification right now.
+ * Pure on purpose (no Android types) so the rules are unit-tested on the JVM.
+ */
+object CreditReminder {
+
+    /**
+     * A spend is due when it is still unresolved (no credit found, or an unconfirmed suggestion), has not been
+     * notified before, has had [settleMinutes] for the real credit SMS to arrive, is not older than [maxAgeDays],
+     * and it is not night time ([quietStartHour]..[quietEndHour]), when everything waits for the morning.
+     */
+    fun due(
+        report: RotationReport,
+        alreadyNotified: Set<Long>,
+        now: LocalDateTime,
+        settleMinutes: Long = 45L,
+        maxAgeDays: Long = 7L,
+        quietStartHour: Int = 22,
+        quietEndHour: Int = 8,
+    ): List<ReminderItem> {
+        if (now.hour >= quietStartHour || now.hour < quietEndHour) return emptyList()
+        val newest = now.minusMinutes(settleMinutes)
+        val oldest = now.minusDays(maxAgeDays)
+        val items = report.needsCredit.map { ReminderItem(it.outId, it.card.label, it.spent, it.at) } +
+            report.suggestions.map { ReminderItem(it.outId, it.card.label, it.spent, it.at) }
+        return items
+            .distinctBy { it.outId }
+            .filter { it.outId !in alreadyNotified }
+            .filter { !it.at.isAfter(newest) && !it.at.isBefore(oldest) }
+            .sortedBy { it.at }
+    }
+}
