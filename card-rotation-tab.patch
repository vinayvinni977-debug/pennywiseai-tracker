@@ -0,0 +1,65 @@
+package com.pennywiseai.tracker.domain.rotation
+
+import java.math.BigDecimal
+import java.net.URLDecoder
+import java.net.URLEncoder
+import java.time.LocalDateTime
+
+/**
+ * Compact text encoding for the user's payment decisions, reconciliations and due-date settings, so they can be
+ * kept in the app's small settings store and carried in a backup. Free text is URL-encoded, so the separators
+ * (| ; ~ ,) can never appear inside a value. Unreadable lines are skipped, never crash the app.
+ */
+object PaymentCodec {
+    private fun enc(s: String) = URLEncoder.encode(s, "UTF-8")
+    private fun dec(s: String) = URLDecoder.decode(s, "UTF-8")
+    private fun amt(v: BigDecimal?) = v?.toPlainString().orEmpty()
+    private fun bd(s: String) = if (s.isEmpty()) null else BigDecimal(s)
+    private fun cardOf(bank: String, last4: String) = if (bank.isEmpty() && last4.isEmpty()) null else CardKey(dec(bank), dec(last4))
+    private fun bankOf(c: CardKey?) = c?.let { enc(it.bank) }.orEmpty()
+    private fun last4Of(c: CardKey?) = c?.let { enc(it.last4) }.orEmpty()
+
+    // ---- decisions ----------------------------------------------------------------------------------
+
+    fun encode(d: PaymentDecision): String {
+        val events = d.history.joinToString("~") { e ->
+            listOf(e.at.toString(), e.status.name, bankOf(e.card), last4Of(e.card), amt(e.amount), enc(e.note)).joinToString(";")
+        }
+        return listOf(d.txnId, d.status.name, bankOf(d.card), last4Of(d.card), amt(d.amount), if (d.reversalDismissed) 1 else 0, events).joinToString("|")
+    }
+
+    fun decodeDecision(line: String): PaymentDecision? = runCatching {
+        val p = line.split("|")
+        val history = p.getOrElse(6) { "" }.split("~").filter { it.isNotEmpty() }.map { raw ->
+            val f = raw.split(";")
+            PaymentEvent(LocalDateTime.parse(f[0]), PaymentStatus.valueOf(f[1]), cardOf(f[2], f[3]), bd(f[4]), dec(f.getOrElse(5) { "" }))
+        }
+        PaymentDecision(p[0].toLong(), PaymentStatus.valueOf(p[1]), cardOf(p[2], p[3]), bd(p[4]), p[5] == "1", history)
+    }.getOrNull()
+
+    fun decodeDecisions(lines: Collection<String>): Map<Long, PaymentDecision> =
+        lines.mapNotNull { decodeDecision(it) }.associateBy { it.txnId }
+
+    // ---- reconciliations -------------------------------------------------------------------------------
+
+    fun encode(r: Reconciliation): String =
+        listOf(enc(r.card.bank), enc(r.card.last4), r.at.toString(), amt(r.bankOutstanding), amt(r.calculatedBefore), amt(r.difference)).joinToString("|")
+
+    fun decodeReconciliation(line: String): Reconciliation? = runCatching {
+        val p = line.split("|")
+        Reconciliation(CardKey(dec(p[0]), dec(p[1])), LocalDateTime.parse(p[2]), BigDecimal(p[3]), BigDecimal(p[4]), BigDecimal(p[5]))
+    }.getOrNull()
+
+    // ---- schedules ----------------------------------------------------------------------------------------
+
+    fun encode(s: CardSchedule): String =
+        listOf(enc(s.card.bank), enc(s.card.last4), s.dueDay?.toString().orEmpty(), s.remindDaysBefore.joinToString(","), if (s.remindOnDue) 1 else 0, if (s.overdueAlerts) 1 else 0).joinToString("|")
+
+    fun decodeSchedule(line: String): CardSchedule? = runCatching {
+        val p = line.split("|")
+        CardSchedule(
+            CardKey(dec(p[0]), dec(p[1])), p[2].toIntOrNull()?.takeIf { it in 1..31 },
+            p[3].split(",").mapNotNull { it.toIntOrNull() }.filter { it in 1..31 }, p[4] == "1", p[5] == "1",
+        )
+    }.getOrNull()
+}
