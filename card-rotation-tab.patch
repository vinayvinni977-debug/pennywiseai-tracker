+/**
+ * Home shortcut to the credit-card dashboard, shown right under the "Money in motion" card. It carries the
+ * confirmed card payments of this month and how many payments still wait for an answer.
+ */
+@Composable
+fun CreditCardsHomeEntry(
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier,
+    viewModel: CardPaymentsViewModel = hiltViewModel(),
+) {
+    val state by viewModel.uiState.collectAsStateWithLifecycle()
+    val report = state.report
+    Card(modifier = modifier.fillMaxWidth().clickable(onClick = onClick)) {
+        Row(
+            Modifier.fillMaxWidth().padding(16.dp),
+            horizontalArrangement = Arrangement.SpaceBetween,
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            Column(Modifier.weight(1f)) {
+                Text("Credit cards", style = MaterialTheme.typography.titleSmall, fontWeight = FontWeight.SemiBold)
+                Text(
+                    if (report == null) "Spent, paid, outstanding and rotation per card"
+                    else "Paid to cards this month: ${inr.format(report.confirmedThisMonth)} (confirmed)",
+                    style = MaterialTheme.typography.bodySmall,
+                )
+                if (report != null && (report.pending.isNotEmpty() || report.questions.isNotEmpty())) {
+                    Text(
+                        "${report.pending.size} payment(s) waiting for your confirmation" +
+                            (if (report.questions.isNotEmpty()) ", ${report.questions.size} to check" else ""),
+                        style = MaterialTheme.typography.bodySmall,
+                        fontWeight = FontWeight.SemiBold,
+                    )
+                }
+            }
+            Text("›", style = MaterialTheme.typography.titleLarge)
+        }
+    }
