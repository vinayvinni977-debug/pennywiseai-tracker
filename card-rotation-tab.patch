+package com.pennywiseai.tracker.domain.rotation
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.math.BigDecimal
+import java.time.LocalDate
+import java.time.LocalDateTime
+
+/** Regression tests for CRED / card-bill payments. Synthetic data only. */
+class CardPaymentsTest {
+    private val t0 = LocalDateTime.of(2026, 10, 20, 10, 0)
+    private val cardA = CardKey("HDFC Bank", "1058")
+    private val cardB = CardKey("ICICI Bank", "6001")
+
+    private fun d(v: String) = BigDecimal(v)
+
+    private fun spend(id: Long, amount: String, card: CardKey = cardA, min: Long = 0) =
+        RotationTxn(id, d(amount), "Shop", RotationKind.CARD_PURCHASE, t0.plusMinutes(min), card.bank, card.last4)
+
+    private fun debit(id: Long, amount: String, min: Long, merchant: String = "CRED Club", text: String = "", bank: String = "Kotak Bank", acct: String? = "1234") =
+        RotationTxn(id, d(amount), merchant, RotationKind.OUTGOING, t0.plusMinutes(min), bank, acct, text)
+
+    private fun credit(id: Long, amount: String, min: Long, merchant: String = "Refund", text: String = "") =
+        RotationTxn(id, d(amount), merchant, RotationKind.INCOMING, t0.plusMinutes(min), "Kotak Bank", "1234", text)
+
+    private fun account(card: CardKey, outstanding: String, asOfMin: Long, limit: String? = "200000") =
+        CardAccount(card.bank, card.last4, d(outstanding), limit?.let { d(it) }, t0.plusMinutes(asOfMin))
+
+    private fun report(
+        txns: List<RotationTxn>, accounts: List<CardAccount> = emptyList(), decisions: Map<Long, PaymentDecision> = emptyMap(),
+        recon: List<Reconciliation> = emptyList(), schedules: List<CardSchedule> = emptyList(), asOfMin: Long = 60L * 24,
+    ) = CardPayments.report(txns, accounts, decisions, recon, schedules, t0.plusMinutes(asOfMin))
+
+    private fun summary(r: PaymentsReport, c: CardKey) = r.cards.first { CardPayments.id(it.card) == CardPayments.id(c) }
+
+    private fun confirm(decisions: Map<Long, PaymentDecision>, t: RotationTxn, card: CardKey, amount: String = t.amount.toPlainString(), minAfter: Long = 5) =
+        CardPayments.confirm(decisions, t, card, d(amount), t0.plusMinutes(minAfter))
+
+    // ---- CRED detection and card selection ------------------------------------------------------
+
+    @Test
+    fun credIsDetected_butCreditAndCreditedAreNot() {
+        assertTrue(CardPayments.isCred(debit(1, "100", 0, merchant = "CRED Club")))
+        assertTrue(CardPayments.isCred(debit(1, "100", 0, merchant = "UPI", text = "paid to cred@axisb")))
+        assertTrue(!CardPayments.isCred(debit(1, "100", 0, merchant = "Credit card bill", text = "amount credited")))
+    }
+
+    @Test
+    fun credAlwaysAsks_evenWhenTheTextNamesACard() {
+        val spendA = spend(1, "50000")
+        val cred = debit(2, "20000", 30, text = "Sent to CRED Club for XX1058")
+        val r = report(listOf(spendA, cred))
+        val row = r.pending.single()
+        assertEquals(PaymentEvidence.CRED, row.evidence)
+        assertEquals(null, row.card)
+        assertEquals(null, row.suggestedCard)
+        assertEquals(PaymentStatus.PENDING, row.status)
+    }
+
+    // ---- two-step confirmation ---------------------------------------------------------------------
+
+    @Test
+    fun previewShowsAmountCardCurrentAndProjectedOutstanding() {
+        val cred = debit(2, "20000", 30)
+        val acct = account(cardA, "50000", 0)
+        val out = CardPayments.outstanding(cardA, listOf(cred), emptyList(), acct, emptyList())
+        val p = CardPayments.preview(cred, cardA, d("20000"), out)
+        assertEquals(d("20000"), p.paymentAmount)
+        assertEquals(cardA, p.card)
+        assertEquals(d("50000"), p.currentOutstanding)
+        assertEquals(d("30000"), p.projectedOutstanding)
+        assertTrue(!p.overpays)
+    }
+
+    @Test
+    fun previewRejectsAmountsThatAreZeroOrAboveTheDebit() {
+        val cred = debit(2, "20000", 30)
+        val out = CardPayments.outstanding(cardA, listOf(cred), emptyList(), account(cardA, "50000", 0), emptyList())
+        var failures = 0
+        for (bad in listOf("0", "20001")) try { CardPayments.preview(cred, cardA, d(bad), out) } catch (e: IllegalArgumentException) { failures++ }
+        assertEquals(2, failures)
+    }
+
+    @Test
+    fun nothingChangesUntilConfirmed_thenOutstandingFallsExactlyOnce() {
+        val cred = debit(2, "20000", 30)
+        val txns = listOf(cred)
+        val acct = listOf(account(cardA, "50000", 0))
+        val before = summary(report(txns, acct), cardA)
+        assertEquals(d("50000"), before.outstanding.amount)
+        assertEquals(d("0"), before.paidAll)
+
+        val decisions = confirm(emptyMap(), cred, cardA)
+        val after = summary(report(txns, acct, decisions), cardA)
+        assertEquals(d("30000"), after.outstanding.amount)
+        assertEquals(d("20000"), after.paidAll)
+    }
+
+    @Test
+    fun confirmingTheSamePaymentTwiceIsRefused() {
+        val cred = debit(2, "20000", 30)
+        val once = confirm(emptyMap(), cred, cardA)
+        var refused = false
+        try { confirm(once, cred, cardB) } catch (e: IllegalStateException) { refused = true }
+        assertTrue(refused)
+    }
+
+    // ---- partial payments and pending payments -------------------------------------------------
+
+    @Test
+    fun partialPaymentReducesByTheConfirmedAmount_andIsNotPaidInFull() {
+        val cred = debit(2, "10000", 30)
+        val acct = listOf(account(cardA, "50000", 0))
+        val decisions = confirm(emptyMap(), cred, cardA, "4000")
+        val s = summary(report(listOf(cred), acct, decisions), cardA)
+        assertEquals(d("46000"), s.outstanding.amount)
+        assertTrue(s.partiallyPaid)
+        assertTrue(!s.paidInFull)
+        val preview = CardPayments.preview(cred, cardA, d("4000"), CardPayments.outstanding(cardA, listOf(cred), emptyList(), acct[0], emptyList()))
+        assertEquals(d("6000"), preview.unallocated)
+    }
+
+    @Test
+    fun pendingPaymentsDoNotTouchAnyBalance() {
+        val rows = listOf(debit(2, "20000", 30), debit(3, "15000", 90))
+        val s = summary(report(rows, listOf(account(cardA, "50000", 0))), cardA)
+        assertEquals(d("50000"), s.outstanding.amount)
+        assertEquals(d("0"), s.paidAll)
+    }
+
+    // ---- one source of truth: never subtracted twice ---------------------------------------------
+
+    @Test
+    fun aPaymentBeforeTheBankFigureIsNotSubtractedAgain_andOneAfterIsSubtractedOnce() {
+        val before = debit(2, "10000", 10)          // already reflected in the bank's figure at minute 20
+        val after = debit(3, "5000", 60)
+        val acct = listOf(account(cardA, "40000", 20))
+        var dec = confirm(emptyMap(), before, cardA)
+        dec = confirm(dec, after, cardA)
+        val s = summary(report(listOf(before, after), acct, dec), cardA)
+        assertEquals(d("35000"), s.outstanding.amount)
+        assertEquals(AnchorKind.BANK_SMS, s.outstanding.anchorKind)
+        assertEquals(d("5000"), s.outstanding.paymentsSince)
+        assertEquals(d("15000"), s.paidAll)
+    }
+
