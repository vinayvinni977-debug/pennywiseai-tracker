+import javax.inject.Inject
+
+data class CardPaymentsUiState(
+    val report: PaymentsReport? = null,
+    /** Recent bank debits not yet treated as card payments, for "I paid a card and it was missed". */
+    val recentDebits: List<RotationTxn> = emptyList(),
+    val isLoading: Boolean = true,
+)
+
+private data class Source(
+    val txns: List<com.pennywiseai.tracker.data.database.entity.TransactionEntity>,
+    val balances: List<com.pennywiseai.tracker.data.database.entity.AccountBalanceEntity>,
+    val inputs: PaymentInputs,
+)
+
+/**
+ * Card-bill payments: pending CRED / NetBanking payments, two-step confirmation, history, reconciliation and
+ * due-date settings. Reads transactions only; it never edits or deletes a transaction. Everything the user
+ * decides is saved in [CardRotationStore].
+ */
+@OptIn(FlowPreview::class)
+@HiltViewModel
+class CardPaymentsViewModel @Inject constructor(
+    private val transactionRepository: TransactionRepository,
+    private val accountBalanceRepository: AccountBalanceRepository,
+    @ApplicationContext context: Context,
+) : ViewModel() {
+
+    private val store = CardRotationStore(context)
+    private val saved = MutableStateFlow(store.paymentInputs())
+    private val _uiState = MutableStateFlow(CardPaymentsUiState())
+    val uiState: StateFlow<CardPaymentsUiState> = _uiState.asStateFlow()
+
+    private val _messages = MutableSharedFlow<String>(extraBufferCapacity = 8)
+    val messages: SharedFlow<String> = _messages.asSharedFlow()
+
+    private var txns: List<RotationTxn> = emptyList()
+    private var accounts: List<CardAccount> = emptyList()
+
+    init {
+        viewModelScope.launch {
+            combine(transactionRepository.getAllTransactions(), accountBalanceRepository.getAllLatestBalances(), saved) { t, b, s -> Source(t, b, s) }
+                .debounce(300)
+                .collect { src ->
+                    val result = withContext(Dispatchers.Default) {
+                        val rows = src.txns.filter { !it.isDeleted && it.currency == "INR" }.mapNotNull { it.toRotationTxn() }
+                        val accts = cardAccountsFrom(src.balances)
+                        val report = buildPaymentsReport(rows, accts, src.inputs)
+                        val inPayments = report.allRows.map { it.txn.id }.toSet()
+                        val cutoff = LocalDateTime.now().minusDays(60)
+                        val recent = rows.filter { it.kind == RotationKind.OUTGOING && it.id !in inPayments && it.dateTime.isAfter(cutoff) }
+                            .sortedByDescending { it.dateTime }.take(40)
+                        Triple(rows, accts, report to recent)
+                    }
+                    txns = result.first
+                    accounts = result.second
+                    _uiState.value = CardPaymentsUiState(report = result.third.first, recentDebits = result.third.second, isLoading = false)
+                }
+        }
+    }
+
+    /** Step 2 of confirmation. Saves nothing. Returns null when the amount is not valid. */
+    fun preview(txn: RotationTxn, card: CardKey, amount: BigDecimal): PaymentPreview? {
+        val report = _uiState.value.report ?: return null
+        val summary = report.cards.firstOrNull { CardPayments.id(it.card) == CardPayments.id(card) } ?: return null
+        return runCatching { CardPayments.preview(txn, card, amount, summary.outstanding) }.getOrNull()
+    }
+
+    /** Called only from the confirmation dialog's final button. */
+    fun confirm(txn: RotationTxn, card: CardKey, amount: BigDecimal) {
+        runCatching { CardPayments.confirm(saved.value.decisions, txn, card, amount, LocalDateTime.now()) }
+            .onSuccess { update { copy(decisions = it) }; _messages.tryEmit("Payment confirmed for ${card.label}") }
+            .onFailure { _messages.tryEmit(it.message ?: "Could not confirm this payment") }
+    }
+
+    fun unassign(txnId: Long) {
+        update { copy(decisions = CardPayments.unassign(decisions, txnId, LocalDateTime.now())) }
+        _messages.tryEmit("Payment moved back to waiting. History kept")
+    }
+
+    fun markStatus(txnId: Long, status: PaymentStatus, note: String) {
+        update { copy(decisions = CardPayments.markStatus(decisions, txnId, status, LocalDateTime.now(), note)) }
+        _messages.tryEmit("Marked ${status.name.lowercase()}")
+    }
+
+    fun notACardPayment(txnId: Long) {
+        update { copy(notCardPayments = notCardPayments + txnId) }
+        _messages.tryEmit("Okay, I won't treat that debit as a card payment")
+    }
+
+    fun dismissReversal(txnId: Long) {
+        update { copy(decisions = CardPayments.dismissReversal(decisions, txnId, LocalDateTime.now())) }
+    }
+
+    /** "Keep both" for a possible duplicate, or "not a reversal" for a possible reversal. */
+    fun answerQuestion(q: PaymentQuestion) {
+        update { copy(answered = answered + questionKey(q)) }
+        if (q is PaymentQuestion.PossibleReversal) dismissReversal(q.txnId)
+    }
+
+    fun flagDuplicate(txnId: Long) {
+        update { copy(decisions = CardPayments.markStatus(decisions, txnId, PaymentStatus.DUPLICATE, LocalDateTime.now(), "Marked as a duplicate by user")) }
+        _messages.tryEmit("Marked as a duplicate. It no longer counts")
+    }
+
+    fun reconcile(card: CardKey, bankOutstanding: BigDecimal) {
+        val summary = _uiState.value.report?.cards?.firstOrNull { CardPayments.id(it.card) == CardPayments.id(card) } ?: return
+        runCatching { CardPayments.reconcile(saved.value.reconciliations, card, bankOutstanding, LocalDateTime.now(), summary.outstanding.amount) }
+            .onSuccess {
+                update { copy(reconciliations = it) }
+                val diff = it.last().difference
+                _messages.tryEmit(if (diff.signum() == 0) "Matches your bank. Reconciled" else "Saved. Difference from PennyWise: ${diff.toPlainString()}")
+            }
+            .onFailure { _messages.tryEmit(it.message ?: "Could not save") }
+    }
+
+    fun saveSchedule(schedule: CardSchedule) {
+        update {
+            copy(schedules = schedules.filter { CardPayments.id(it.card) != CardPayments.id(schedule.card) } + schedule)
+        }
+        _messages.tryEmit("Due date and reminders saved")
+    }
+
+    private fun update(change: PaymentInputs.() -> PaymentInputs) {
+        val next = saved.value.change()
+        store.savePaymentDecisions(next.decisions)
+        store.saveReconciliations(next.reconciliations)
+        store.saveSchedules(next.schedules)
+        store.saveNotCardPayments(next.notCardPayments)
+        store.saveAnsweredQuestions(next.answered)
+        saved.value = next
+    }
+}
