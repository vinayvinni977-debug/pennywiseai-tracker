@@ -0,0 +1,53 @@
+package com.pennywiseai.tracker.presentation.rotation
+
+import com.pennywiseai.tracker.data.database.entity.AccountBalanceEntity
+import com.pennywiseai.tracker.domain.rotation.CardAccount
+import com.pennywiseai.tracker.domain.rotation.CardPayments
+import com.pennywiseai.tracker.domain.rotation.CardSchedule
+import com.pennywiseai.tracker.domain.rotation.PaymentDecision
+import com.pennywiseai.tracker.domain.rotation.PaymentQuestion
+import com.pennywiseai.tracker.domain.rotation.PaymentsReport
+import com.pennywiseai.tracker.domain.rotation.Reconciliation
+import com.pennywiseai.tracker.domain.rotation.RotationKind
+import com.pennywiseai.tracker.domain.rotation.RotationTxn
+import java.time.LocalDateTime
+
+/** The user's saved choices about card payments, read once so every screen computes from the same inputs. */
+data class PaymentInputs(
+    val decisions: Map<Long, PaymentDecision>,
+    val reconciliations: List<Reconciliation>,
+    val schedules: List<CardSchedule>,
+    val notCardPayments: Set<Long>,
+    val answered: Set<String>,
+)
+
+fun CardRotationStore.paymentInputs() = PaymentInputs(
+    decisions = paymentDecisions(),
+    reconciliations = reconciliations(),
+    schedules = schedules(),
+    notCardPayments = notCardPayments(),
+    answered = answeredQuestions(),
+)
+
+/** Credit-card accounts with the time of the bank's own outstanding figure. */
+fun cardAccountsFrom(balances: List<AccountBalanceEntity>): List<CardAccount> =
+    balances.filter { it.isCreditCard }
+        .map { CardAccount(it.bankName, it.accountLast4, it.balance, it.creditLimit, it.timestamp) }
+
+fun questionKey(q: PaymentQuestion): String = when (q) {
+    is PaymentQuestion.PossibleDuplicate -> "dup:${q.txnId}:${q.otherTxnId}"
+    is PaymentQuestion.PossibleReversal -> "rev:${q.txnId}:${q.creditTxnId}"
+}
+
+/** Builds the single payments report every screen and the reminder worker use. */
+fun buildPaymentsReport(
+    txns: List<RotationTxn>,
+    accounts: List<CardAccount>,
+    inputs: PaymentInputs,
+    now: LocalDateTime = LocalDateTime.now(),
+): PaymentsReport {
+    // Debits the user said are not card payments are left out of payment detection altogether.
+    val usable = txns.filterNot { it.kind == RotationKind.OUTGOING && it.id in inputs.notCardPayments && it.id !in inputs.decisions }
+    val raw = CardPayments.report(usable, accounts, inputs.decisions, inputs.reconciliations, inputs.schedules, now)
+    return raw.copy(questions = raw.questions.filter { questionKey(it) !in inputs.answered })
+}
