--- /dev/null
+++ b/app/src/main/java/com/pennywiseai/tracker/domain/rotation/CardDashboard.kt
@@ -0,0 +1,157 @@
+package com.pennywiseai.tracker.domain.rotation
+
+import java.math.BigDecimal
+import java.time.LocalDateTime
+import java.time.YearMonth
+
+/** A credit-card account as stored by the app (balance = outstanding, as the app's own "available credit" uses). */
+data class CardAccount(
+    val bank: String,
+    val last4: String,
+    val outstanding: BigDecimal?,
+    val limit: BigDecimal?,
+)
+
+enum class ActivityKind { SPEND, PAYMENT, ROTATION_SPEND, ROTATION_CREDIT, ROTATION_ONWARD }
+
+data class CardActivity(
+    val id: Long,
+    val at: LocalDateTime,
+    val kind: ActivityKind,
+    val title: String,
+    val amount: BigDecimal,
+)
+
+data class CardSummary(
+    val card: CardKey,
+    val spentMonth: BigDecimal,
+    val spentAll: BigDecimal,
+    val paidMonth: BigDecimal,
+    val paidAll: BigDecimal,
+    /** Outstanding as the bank's SMS last reported it, when the app has it. */
+    val outstanding: BigDecimal?,
+    val limit: BigDecimal?,
+    /** spent - paid over the history the app has seen; only an estimate (history may start mid-cycle). */
+    val estimatedOwed: BigDecimal,
+    val rotated: BigDecimal,
+    val rotationCharges: BigDecimal,
+    val activity: List<CardActivity>,
+) {
+    val usedPercent: Int?
+        get() = if (outstanding != null && limit != null && limit.signum() > 0)
+            outstanding.multiply(BigDecimal(100)).divide(limit, 0, java.math.RoundingMode.HALF_UP).toInt()
+        else null
+}
+
+/** A card-bill payment (often "CRED Club") that the bank SMS did not tie to a card. */
+data class UnassignedPayment(
+    val id: Long,
+    val at: LocalDateTime,
+    val title: String,
+    val amount: BigDecimal,
+)
+
+data class DashboardReport(
+    val cards: List<CardSummary>,
+    /** Card-bill payments with no card last-4 we could match; the user can assign them by hand. */
+    val unassigned: List<UnassignedPayment> = emptyList(),
+) {
+    val unassignedPaid: BigDecimal get() = unassigned.fold(BigDecimal.ZERO) { a, p -> a + p.amount }
+    val spentMonth: BigDecimal get() = cards.fold(BigDecimal.ZERO) { a, c -> a + c.spentMonth }
+    val paidMonth: BigDecimal get() = cards.fold(BigDecimal.ZERO) { a, c -> a + c.paidMonth }
+    val rotationCharges: BigDecimal get() = cards.fold(BigDecimal.ZERO) { a, c -> a + c.rotationCharges }
+
+    /** Bank-reported outstanding where known, otherwise the estimate. */
+    val outstanding: BigDecimal get() = cards.fold(BigDecimal.ZERO) { a, c -> a + (c.outstanding ?: c.estimatedOwed) }
+}
+
+/** Per-card spend / paid / outstanding / rotation view. Pure (no Android types) so it is unit-tested on the JVM. */
+object CardDashboard {
+
+    fun build(
+        txns: List<RotationTxn>,
+        accounts: List<CardAccount>,
+        report: RotationReport,
+        asOf: LocalDateTime = LocalDateTime.now(),
+        activityLimit: Int = 25,
+        /** Payment id -> the card the user said it paid (for CRED / UPI payments that carry no card digits). */
+        assignments: Map<Long, CardKey> = emptyMap(),
+    ): DashboardReport {
+        class Acc(val key: CardKey) {
+            var spentMonth = BigDecimal.ZERO
+            var spentAll = BigDecimal.ZERO
+            var paidMonth = BigDecimal.ZERO
+            var paidAll = BigDecimal.ZERO
+            val activity = ArrayList<CardActivity>()
+        }
+
+        fun norm(bank: String?, last4: String) = "${bank.orEmpty().trim().lowercase()}|$last4"
+        fun last4(s: String?) = s.orEmpty().filter { it.isDigit() }.takeLast(4)
+
+        val accs = LinkedHashMap<String, Acc>()
+        fun acc(bank: String?, l4: String): Acc {
+            val display = bank?.takeIf { it.isNotBlank() } ?: "Card"
+            return accs.getOrPut(norm(display, l4)) { Acc(CardKey(display, l4)) }
+        }
+
+        val rotationOut = report.cards.flatMap { c -> c.rotations.map { it.outId } }.toSet()
+        val month = YearMonth.from(asOf)
+
+        for (t in txns.filter { it.kind == RotationKind.CARD_PURCHASE }) {
+            val a = acc(t.bankName, last4(t.account))
+            a.spentAll += t.amount
+            if (YearMonth.from(t.dateTime) == month) a.spentMonth += t.amount
+            val kind = if (t.id in rotationOut) ActivityKind.ROTATION_SPEND else ActivityKind.SPEND
+            a.activity += CardActivity(t.id, t.dateTime, kind, t.merchant, t.amount)
+        }
+        // A known card account with no purchases yet still gets a row (its outstanding is useful on its own).
+        for (c in accounts) acc(c.bank, c.last4)
+
+        // Card-bill payments leave a bank account; the card's own "payment received" SMS is skipped by the parsers.
+        val unassigned = ArrayList<UnassignedPayment>()
+        val keyed = accs.values.filter { it.key.last4.isNotBlank() }
+        for (t in txns.filter { it.kind == RotationKind.OUTGOING && CardRotation.CARD_BILL_WORDS.containsMatchIn("${it.merchant} ${it.text}") }) {
+            val haystack = "${t.merchant} ${t.text}"
+            val manual = assignments[t.id]?.let { k -> accs[norm(k.bank, k.last4)] }
+            val hit = keyed.filter { Regex("(?<!\\d)${it.key.last4}(?!\\d)").containsMatchIn(haystack) }
+            val target = manual ?: hit.singleOrNull()
+            if (target == null) { unassigned += UnassignedPayment(t.id, t.dateTime, t.merchant, t.amount); continue }
+            target.paidAll += t.amount
+            if (YearMonth.from(t.dateTime) == month) target.paidMonth += t.amount
+            target.activity += CardActivity(t.id, t.dateTime, ActivityKind.PAYMENT, t.merchant, t.amount)
+        }
+
+        // The rotation loop, shown under the card that was rotated.
+        val byId = txns.associateBy { it.id }
+        for (ledger in report.cards) {
+            val a = acc(ledger.card.bank, ledger.card.last4)
+            for (p in ledger.rotations) {
+                byId[p.inId]?.let { a.activity += CardActivity(it.id, it.dateTime, ActivityKind.ROTATION_CREDIT, it.merchant, it.amount) }
+                p.onwardId?.let { id -> byId[id]?.let { a.activity += CardActivity(it.id, it.dateTime, ActivityKind.ROTATION_ONWARD, it.merchant, it.amount) } }
+            }
+        }
+
+        val ledgers = report.cards.associateBy { norm(it.card.bank, it.card.last4) }
+        val accountByKey = accounts.associateBy { norm(it.bank, it.last4) }
+
+        val cards = accs.map { (k, a) ->
+            val l = ledgers[k]
+            val acct = accountByKey[k]
+            CardSummary(
+                card = a.key,
+                spentMonth = a.spentMonth,
+                spentAll = a.spentAll,
+                paidMonth = a.paidMonth,
+                paidAll = a.paidAll,
+                outstanding = acct?.outstanding,
+                limit = acct?.limit,
+                estimatedOwed = (a.spentAll - a.paidAll).max(BigDecimal.ZERO),
+                rotated = l?.rotated ?: BigDecimal.ZERO,
+                rotationCharges = l?.charges ?: BigDecimal.ZERO,
+                activity = a.activity.distinctBy { it.id to it.kind }.sortedByDescending { it.at }.take(activityLimit),
+            )
+        }.sortedWith(compareByDescending<CardSummary> { it.spentMonth }.thenByDescending { it.spentAll })
+
+        return DashboardReport(cards = cards, unassigned = unassigned.sortedByDescending { it.at })
+    }
+}
diff --git a/app/src/main/java/com/pennywiseai/tracker/domain/rotation/CardRotation.kt b/app/src/main/java/com/pennywiseai/tracker/domain/rotation/CardRotation.kt
