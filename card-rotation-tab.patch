+++ b/app/src/main/java/com/pennywiseai/tracker/worker/CardCreditCheckWorker.kt
@@ -0,0 +1,165 @@
+package com.pennywiseai.tracker.worker
+
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import androidx.core.app.NotificationCompat
+import androidx.hilt.work.HiltWorker
+import androidx.work.CoroutineWorker
+import androidx.work.ExistingPeriodicWorkPolicy
+import androidx.work.PeriodicWorkRequestBuilder
+import androidx.work.WorkManager
+import androidx.work.WorkerParameters
+import com.pennywiseai.tracker.MainActivity
+import com.pennywiseai.tracker.R
+import com.pennywiseai.tracker.data.repository.AccountBalanceRepository
+import com.pennywiseai.tracker.data.repository.TransactionRepository
+import com.pennywiseai.tracker.domain.rotation.CardPayments
+import com.pennywiseai.tracker.domain.rotation.DueAlertKind
+import com.pennywiseai.tracker.domain.rotation.RotationTxn
+import com.pennywiseai.tracker.presentation.rotation.buildPaymentsReport
+import com.pennywiseai.tracker.presentation.rotation.cardAccountsFrom
+import com.pennywiseai.tracker.presentation.rotation.paymentInputs
+import com.pennywiseai.tracker.domain.rotation.CardRotation
+import com.pennywiseai.tracker.domain.rotation.CreditReminder
+import com.pennywiseai.tracker.presentation.rotation.CardRotationStore
+import com.pennywiseai.tracker.presentation.rotation.toRotationTxn
+import dagger.assisted.Assisted
+import dagger.assisted.AssistedInject
+import kotlinx.coroutines.flow.first
+import java.math.BigDecimal
+import java.text.NumberFormat
+import java.time.LocalDateTime
+import java.util.Locale
+import java.util.concurrent.TimeUnit
+
+/**
+ * Hourly check for credit-card spends that never got a matching bank credit. Once a spend has had time for
+ * its credit SMS to arrive, the user is asked once "was a credit missed?"; tapping opens Card rotation.
+ * It reads the same data as the screen and does not touch the SMS receiver.
+ */
+/**
+ * Hourly background checks for credit cards:
+ *  1. a card spend that never got a matching bank credit ("was a credit missed?"), asked once;
+ *  2. bill due dates the user set per card (before, on the day, overdue), each announced once.
+ * Reads the same data as the screens and never touches the SMS receiver.
+ */
+@HiltWorker
+class CardCreditCheckWorker @AssistedInject constructor(
+    @Assisted appContext: Context,
+    @Assisted workerParams: WorkerParameters,
+    private val transactionRepository: TransactionRepository,
+    private val accountBalanceRepository: AccountBalanceRepository,
+) : CoroutineWorker(appContext, workerParams) {
+
+    override suspend fun doWork(): Result {
+        val context = applicationContext
+        val store = CardRotationStore(context)
+        val notificationManager = context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
+        // Nothing to say if the user turned notifications off; try again next run.
+        if (!notificationManager.areNotificationsEnabled()) return Result.success()
+
+        val now = LocalDateTime.now()
+        val rows = transactionRepository.getAllTransactions().first()
+            .filter { !it.isDeleted && it.currency == "INR" }
+            .mapNotNull { it.toRotationTxn() }
+        notificationManager.createNotificationChannel(
+            NotificationChannel(CHANNEL_ID, "Card rotation reminders", NotificationManager.IMPORTANCE_DEFAULT).apply {
+                description = "Missing credits and credit-card bill due dates"
+            },
+        )
+        if (store.remindersEnabled) checkMissingCredits(store, notificationManager, rows, now)
+        checkDueDates(store, notificationManager, rows, now)
+        return Result.success()
+    }
+
+    private fun openIntent(extra: String): PendingIntent {
+        val open = Intent(applicationContext, MainActivity::class.java)
+            .putExtra(extra, true)
+            .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TOP)
+        return PendingIntent.getActivity(applicationContext, extra.hashCode(), open, PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE)
+    }
+
+    private fun checkMissingCredits(store: CardRotationStore, nm: NotificationManager, rows: List<RotationTxn>, now: LocalDateTime) {
+        val report = CardRotation.analyze(
+            rows,
+            links = store.links(),
+            dismissedOutIds = store.dismissed(),
+            askMinAmount = BigDecimal(store.askMinAmount),
+            windowMinutes = store.windowHours * 60L,
+            onwardWindowMinutes = store.windowHours * 60L,
+            asOf = now,
+        )
+        val due = CreditReminder.due(report, store.notified(), now)
+        if (due.isEmpty()) return
+        val inr = NumberFormat.getCurrencyInstance(Locale.Builder().setLanguage("en").setRegion("IN").build())
+        val text = if (due.size == 1) {
+            val d = due.first()
+            "${inr.format(d.spent)} on ${d.cardLabel} has no matching credit. Tap to add it or dismiss."
+        } else {
+            val total = due.fold(BigDecimal.ZERO) { a, d -> a + d.spent }
+            "${due.size} card spends (${inr.format(total)}) have no matching credit. Tap to review."
+        }
+        val notification = NotificationCompat.Builder(applicationContext, CHANNEL_ID)
+            .setSmallIcon(R.drawable.ic_launcher_foreground)
+            .setContentTitle("Was a credit missed?")
+            .setContentText(text)
+            .setStyle(NotificationCompat.BigTextStyle().bigText(text))
+            .setContentIntent(openIntent(MainActivity.EXTRA_OPEN_CARD_ROTATION))
+            .setAutoCancel(true)
+            // Amounts stay off the lock screen, like the other alerts.
+            .setVisibility(NotificationCompat.VISIBILITY_PRIVATE)
+            .build()
+        nm.notify(NOTIFICATION_ID, notification)
+        store.addNotified(due.map { it.outId })
+    }
+
+    private suspend fun checkDueDates(store: CardRotationStore, nm: NotificationManager, rows: List<RotationTxn>, now: LocalDateTime) {
+        // Quiet hours: nothing between 10 PM and 8 AM; the alert waits for the morning.
+        if (now.hour < 8 || now.hour >= 22) return
+        val inputs = store.paymentInputs()
+        if (inputs.schedules.none { it.dueDay != null }) return
+        val accounts = cardAccountsFrom(accountBalanceRepository.getAllLatestBalancesOnce())
+        val report = buildPaymentsReport(rows, accounts, inputs, now)
+        val outstanding = report.cards.associate { CardPayments.id(it.card) to it.outstanding }
+        val alerts = CardPayments.dueAlerts(inputs.schedules, outstanding, now.toLocalDate(), store.dueAlertsSent())
+        if (alerts.isEmpty()) return
+        val inr = NumberFormat.getCurrencyInstance(Locale.Builder().setLanguage("en").setRegion("IN").build())
+        val lines = alerts.map { a ->
+            val owed = outstanding[CardPayments.id(a.card)]?.takeIf { !it.isEstimate }?.amount?.max(BigDecimal.ZERO)?.let { " (${inr.format(it)} outstanding)" }.orEmpty()
+            when (a.kind) {
+                DueAlertKind.BEFORE -> "${a.card.label}: bill due in ${a.daysBefore} day(s), on ${a.dueDate}$owed"
+                DueAlertKind.ON_DUE -> "${a.card.label}: bill is due today$owed"
+                DueAlertKind.OVERDUE -> "${a.card.label}: bill was due on ${a.dueDate} and is still unpaid$owed"
+            }
+        }
+        val text = lines.joinToString("\n")
+        val notification = NotificationCompat.Builder(applicationContext, CHANNEL_ID)
+            .setSmallIcon(R.drawable.ic_launcher_foreground)
+            .setContentTitle(if (alerts.any { it.kind == DueAlertKind.OVERDUE }) "Credit card bill overdue" else "Credit card bill due")
+            .setContentText(lines.first())
+            .setStyle(NotificationCompat.BigTextStyle().bigText(text))
+            .setContentIntent(openIntent(MainActivity.EXTRA_OPEN_CARD_PAYMENTS))
+            .setAutoCancel(true)
+            .setVisibility(NotificationCompat.VISIBILITY_PRIVATE)
+            .build()
+        nm.notify(DUE_NOTIFICATION_ID, notification)
+        store.addDueAlertsSent(alerts.map { it.key })
+    }
+
+    companion object {
+        private const val WORK_NAME = "card_credit_check"
+        private const val CHANNEL_ID = "card_rotation_reminders"
+        // Transaction alerts use the transaction id and the recap uses -2; ids are never below -2 here.
+        private const val NOTIFICATION_ID = -3
+        private const val DUE_NOTIFICATION_ID = -4
+
+        fun enqueuePeriodic(context: Context) {
+            val request = PeriodicWorkRequestBuilder<CardCreditCheckWorker>(1, TimeUnit.HOURS).build()
+            WorkManager.getInstance(context)
+                .enqueueUniquePeriodicWork(WORK_NAME, ExistingPeriodicWorkPolicy.KEEP, request)
+        }
+    }
+}
