diff --git a/app/src/main/java/com/pennywiseai/tracker/domain/rotation/CardDashboard.kt b/app/src/main/java/com/pennywiseai/tracker/domain/rotation/CardDashboard.kt
new file mode 100644
index 00000000..a409a30b
--- /dev/null
+++ b/app/src/main/java/com/pennywiseai/tracker/domain/rotation/CardDashboard.kt
@@ -0,0 +1,122 @@
+package com.pennywiseai.tracker.domain.rotation
+
+import java.math.BigDecimal
+import java.time.LocalDateTime
+import java.time.YearMonth
+
+/** A credit-card account as stored by the app (balance = outstanding, as the app's own "available credit" uses). */
+data class CardAccount(
+    val bank: String,
+    val last4: String,
+    val outstanding: BigDecimal?,
+    val limit: BigDecimal?,
+    /** When the bank's SMS gave that outstanding figure; it anchors the calculation. */
+    val asOf: LocalDateTime? = null,
+)
+
+enum class ActivityKind { SPEND, PAYMENT, ROTATION_SPEND, ROTATION_CREDIT, ROTATION_ONWARD }
+
+data class CardActivity(
+    val id: Long,
+    val at: LocalDateTime,
+    val kind: ActivityKind,
+    val title: String,
+    val amount: BigDecimal,
+    /** For payments: confirmed, reversed, failed... so the history shows every outcome. */
+    val status: PaymentStatus? = null,
+)
+
+data class CardSummary(
+    val card: CardKey,
+    val spentMonth: BigDecimal,
+    val spentAll: BigDecimal,
+    /** Confirmed payments only. */
+    val paidMonth: BigDecimal,
+    val paidAll: BigDecimal,
+    /** From one source of truth: the bank's or the user's reconciled figure, plus later spends, minus later confirmed payments. */
+    val outstanding: Outstanding,
+    val limit: BigDecimal?,
+    val rotated: BigDecimal,
+    val rotationCharges: BigDecimal,
+    val partiallyPaid: Boolean,
+    val paidInFull: Boolean,
+    val activity: List<CardActivity>,
+) {
+    /** Only shown when the outstanding is anchored to a real figure; an estimate is never presented as exact. */
+    val usedPercent: Int?
+        get() = if (!outstanding.isEstimate && limit != null && limit.signum() > 0)
+            outstanding.amount.max(BigDecimal.ZERO).multiply(BigDecimal(100)).divide(limit, 0, java.math.RoundingMode.HALF_UP).toInt()
+        else null
+}
+
+data class DashboardReport(
+    val cards: List<CardSummary>,
+    /** Bank debits that look like card payments and still wait for the user's confirmation. */
+    val pending: List<PaymentRow> = emptyList(),
+    val questions: Int = 0,
+    val confirmedPaidThisMonth: BigDecimal = BigDecimal.ZERO,
+) {
+    val pendingAmount: BigDecimal get() = pending.fold(BigDecimal.ZERO) { a, p -> a + p.txn.amount }
+    val spentMonth: BigDecimal get() = cards.fold(BigDecimal.ZERO) { a, c -> a + c.spentMonth }
+    val rotationCharges: BigDecimal get() = cards.fold(BigDecimal.ZERO) { a, c -> a + c.rotationCharges }
+    val outstanding: BigDecimal get() = cards.fold(BigDecimal.ZERO) { a, c -> a + c.outstanding.amount.max(BigDecimal.ZERO) }
+    val hasEstimates: Boolean get() = cards.any { it.outstanding.isEstimate }
+}
+
+/** Per-card spend / paid / outstanding / rotation view. Pure (no Android types) so it is unit-tested on the JVM. */
+object CardDashboard {
+
+    fun build(
+        txns: List<RotationTxn>,
+        report: RotationReport,
+        payments: PaymentsReport,
+        asOf: LocalDateTime = LocalDateTime.now(),
+        activityLimit: Int = 25,
+    ): DashboardReport {
+        val month = YearMonth.from(asOf)
+        val rotationOut = report.cards.flatMap { c -> c.rotations.map { it.outId } }.toSet()
+        val byId = txns.associateBy { it.id }
+        val ledgers = report.cards.associateBy { CardPayments.id(it.card) }
+        val purchases = txns.filter { it.kind == RotationKind.CARD_PURCHASE }
+
+        val cards = payments.cards.map { p ->
+            val key = CardPayments.id(p.card)
+            val mine = purchases.filter { t ->
+                CardPayments.id(CardKey(t.bankName?.takeIf { it.isNotBlank() } ?: "Card", t.account.orEmpty().filter { it.isDigit() }.takeLast(4))) == key
+            }
+            val activity = ArrayList<CardActivity>()
+            mine.forEach { t ->
+                activity += CardActivity(t.id, t.dateTime, if (t.id in rotationOut) ActivityKind.ROTATION_SPEND else ActivityKind.SPEND, t.merchant, t.amount)
+            }
+            p.payments.forEach { r ->
+                activity += CardActivity(r.txn.id, r.txn.dateTime, ActivityKind.PAYMENT, r.txn.merchant, r.amount ?: r.txn.amount, r.status)
+            }
+            val ledger = ledgers[key]
+            ledger?.rotations?.forEach { rot ->
+                byId[rot.inId]?.let { activity += CardActivity(it.id, it.dateTime, ActivityKind.ROTATION_CREDIT, it.merchant, it.amount) }
+                rot.onwardId?.let { id -> byId[id]?.let { activity += CardActivity(it.id, it.dateTime, ActivityKind.ROTATION_ONWARD, it.merchant, it.amount) } }
+            }
+            CardSummary(
+                card = p.card,
+                spentMonth = mine.filter { YearMonth.from(it.dateTime) == month }.fold(BigDecimal.ZERO) { a, t -> a + t.amount },
+                spentAll = mine.fold(BigDecimal.ZERO) { a, t -> a + t.amount },
+                paidMonth = p.paidMonth,
+                paidAll = p.paidAll,
+                outstanding = p.outstanding,
+                limit = p.limit,
+                rotated = ledger?.rotated ?: BigDecimal.ZERO,
+                rotationCharges = ledger?.charges ?: BigDecimal.ZERO,
+                partiallyPaid = p.partiallyPaid,
+                paidInFull = p.paidInFull,
+                activity = activity.distinctBy { Triple(it.id, it.kind, it.status) }.sortedByDescending { it.at }.take(activityLimit),
+            )
+        }.sortedWith(compareByDescending<CardSummary> { it.spentMonth }.thenByDescending { it.spentAll })
+
+        return DashboardReport(
+            cards = cards,
+            pending = payments.pending,
+            questions = payments.questions.size,
+            confirmedPaidThisMonth = payments.confirmedThisMonth,
+        )
+    }
+}
diff --git a/app/src/main/java/com/pennywiseai/tracker/domain/rotation/CardPayments.kt b/app/src/main/java/com/pennywiseai/tracker/domain/rotation/CardPayments.kt
new file mode 100644
index 00000000..0853f3db
--- /dev/null
+++ b/app/src/main/java/com/pennywiseai/tracker/domain/rotation/CardPayments.kt
@@ -0,0 +1,466 @@
+package com.pennywiseai.tracker.domain.rotation
+
+import java.math.BigDecimal
+import java.time.Duration
+import java.time.LocalDate
+import java.time.LocalDateTime
+import java.time.YearMonth
+
+/**
+ * Credit-card bill payments.
+ *
+ * A bank debit is only a *candidate* payment. It reduces a card's outstanding amount only after the user has
+ * chosen the card and confirmed (CRED and HDFC NetBanking always ask), or when the SMS names the card's own
+ * last four digits. Pending, failed, reversed and duplicate payments never change a balance.
+ *
+ * One source of truth for outstanding: an anchor (the bank's own figure, or a figure the user reconciled) plus
+ * card spends after the anchor, minus confirmed payments after the anchor. Payments are always derived from the
+ * transactions plus the user's decisions; no stored balance is ever adjusted a second time.
+ *
+ * Pure Kotlin (no Android types) so it is unit-tested on the JVM.
+ */
+
+enum class PaymentStatus { PENDING, CONFIRMED, FAILED, REVERSED, DUPLICATE }
+
+enum class PaymentEvidence { CRED, HDFC_NETBANKING, CARD_WORDS, CARD_LAST4, USER_MARKED }
+
+/** One step in a payment's life, kept so history is never lost. */
+data class PaymentEvent(
+    val at: LocalDateTime,
+    val status: PaymentStatus,
+    val card: CardKey?,
+    val amount: BigDecimal?,
+    val note: String,
+)
+
+/** What the user decided about one bank debit. A stored decision always wins over anything derived. */
+data class PaymentDecision(
+    val txnId: Long,
+    val status: PaymentStatus,
+    val card: CardKey?,
+    /** Confirmed amount for the card. May be less than the debit (partial payment of the bill). */
+    val amount: BigDecimal?,
+    /** The user said "this was not a failed/reversed payment", so auto-reversal is switched off for it. */
+    val reversalDismissed: Boolean = false,
+    val history: List<PaymentEvent> = emptyList(),
+)
+
+/** A payment row as the app shows it. [basis] says who decided: the user, SMS evidence, or an automatic rule. */
+data class PaymentRow(
+    val txn: RotationTxn,
+    val status: PaymentStatus,
+    val card: CardKey?,
+    val amount: BigDecimal?,
+    val evidence: PaymentEvidence?,
+    val basis: Basis,
+    val note: String,
+    val history: List<PaymentEvent>,
+    val suggestedCard: CardKey? = null,
+) {
+    enum class Basis { USER, EVIDENCE, AUTO, NONE }
+}
+
+/** The second confirmation step: exactly what will change, shown before anything is saved. */
+data class PaymentPreview(
+    val paymentAmount: BigDecimal,
+    val card: CardKey,
+    val currentOutstanding: BigDecimal,
+    val projectedOutstanding: BigDecimal,
+    val overpays: Boolean,
+    val unallocated: BigDecimal,
+)
+
+enum class AnchorKind { RECONCILED, BANK_SMS, NONE }
+
+data class Outstanding(
+    val amount: BigDecimal,
+    val anchorKind: AnchorKind,
+    val anchorAt: LocalDateTime?,
+    /** True when there is no bank figure to anchor to, so the number is built from recorded history only. */
+    val isEstimate: Boolean,
+    val spendsSince: BigDecimal,
+    val paymentsSince: BigDecimal,
+)
+
+data class Reconciliation(
+    val card: CardKey,
+    val at: LocalDateTime,
+    val bankOutstanding: BigDecimal,
+    val calculatedBefore: BigDecimal,
+    val difference: BigDecimal,
+)
+
+data class CardSchedule(
+    val card: CardKey,
+    /** Day of month the bill is due (1-31); null until the user sets it. Never guessed. */
+    val dueDay: Int? = null,
+    val remindDaysBefore: List<Int> = listOf(3, 1),
+    val remindOnDue: Boolean = true,
+    val overdueAlerts: Boolean = true,
+)
+
+enum class DueAlertKind { BEFORE, ON_DUE, OVERDUE }
+
+data class DueAlert(
+    val card: CardKey,
+    val kind: DueAlertKind,
+    val dueDate: LocalDate,
+    val daysBefore: Int?,
+    /** Stable id so the same event is never announced twice. */
+    val key: String,
+)
+
+/** Something the app cannot settle alone and must ask about. */
+sealed class PaymentQuestion {
+    abstract val txnId: Long
+
+    data class PossibleDuplicate(override val txnId: Long, val otherTxnId: Long) : PaymentQuestion()
+    data class PossibleReversal(override val txnId: Long, val creditTxnId: Long, val creditAt: LocalDateTime) : PaymentQuestion()
+}
+
+data class CardPaymentSummary(
+    val card: CardKey,
+    val outstanding: Outstanding,
+    val limit: BigDecimal?,
+    val paidMonth: BigDecimal,
+    val paidAll: BigDecimal,
+    val payments: List<PaymentRow>,
+    val reconciliations: List<Reconciliation>,
+    val schedule: CardSchedule?,
+    val nextDue: LocalDate?,
+    /** Confirmed payments exist but the bill is not cleared: a partial payment never counts as paid in full. */
+    val partiallyPaid: Boolean,
+    val paidInFull: Boolean,
+)
+
+data class PaymentsReport(
+    val pending: List<PaymentRow>,
+    val cards: List<CardPaymentSummary>,
+    val questions: List<PaymentQuestion>,
+    val allRows: List<PaymentRow>,
+    val confirmedThisMonth: BigDecimal,
+)
+
+object CardPayments {
+
+    private val CRED = Regex("\\bcred\\b", RegexOption.IGNORE_CASE)
+    private val HDFC_CHANNEL = Regex("net\\s*banking|netbanking|\\bnb\\b|bill\\s*pay|billpay|\\bneft\\b|\\bimps\\b", RegexOption.IGNORE_CASE)
+    private val CARD_PAY = Regex("credit\\s*card|\\bcc\\b|card\\s*(payment|bill|dues|no)|cardpay", RegexOption.IGNORE_CASE)
+    private val FAILED_WORDS = Regex("\\b(failed|unsuccessful|declined)\\b", RegexOption.IGNORE_CASE)
+    private val REVERSED_WORDS = Regex("\\b(reversed|reversal|refund(ed)?|returned|cancel(l)?ed)\\b", RegexOption.IGNORE_CASE)
+    private val REFERENCE = Regex("(?<![0-9])[0-9]{10,16}(?![0-9])")
+
+    // ---- detection -------------------------------------------------------------------------------------
+
+    fun isCred(t: RotationTxn): Boolean = CRED.containsMatchIn("${t.merchant} ${t.text}")
+
+    fun isLikelyHdfcCardPayment(t: RotationTxn): Boolean {
+        val s = "${t.merchant} ${t.text}"
+        return t.bankName?.contains("hdfc", ignoreCase = true) == true &&
+            HDFC_CHANNEL.containsMatchIn(s) && CARD_PAY.containsMatchIn(s)
+    }
+
+    private fun cardWords(t: RotationTxn): Boolean = CARD_PAY.containsMatchIn("${t.merchant} ${t.text}")
+
+    /** The one known card whose full last four digits appear in the text, or null (never a partial match). */
+    fun cardByLast4(t: RotationTxn, cards: List<CardKey>): CardKey? {
+        val s = "${t.merchant} ${t.text}"
+        return cards.filter { it.last4.length == 4 && Regex("(?<![0-9])${it.last4}(?![0-9])").containsMatchIn(s) }
+            .distinctBy { id(it) }.singleOrNull()
+    }
+
+    fun evidenceOf(t: RotationTxn, cards: List<CardKey>): PaymentEvidence? = when {
+        t.kind != RotationKind.OUTGOING -> null
+        isCred(t) -> PaymentEvidence.CRED
+        isLikelyHdfcCardPayment(t) -> PaymentEvidence.HDFC_NETBANKING
+        cardWords(t) && cardByLast4(t, cards) != null -> PaymentEvidence.CARD_LAST4
+        cardWords(t) -> PaymentEvidence.CARD_WORDS
+        else -> null
+    }
+
+    fun id(c: CardKey) = "${c.bank.trim().lowercase()}|${c.last4}"
+
+    // ---- confirmation (two steps) -----------------------------------------------------------------------
+
+    /** Step 2 of confirmation: nothing is saved by this call. */
+    fun preview(txn: RotationTxn, card: CardKey, amount: BigDecimal, outstanding: Outstanding): PaymentPreview {
+        require(amount.signum() > 0) { "Payment amount must be above zero" }
+        require(amount <= txn.amount) { "Confirmed amount cannot be more than the bank debit" }
+        val projected = outstanding.amount - amount
+        return PaymentPreview(amount, card, outstanding.amount, projected, projected.signum() < 0, txn.amount - amount)
+    }
+
+    /** Saves the user's confirmation. Fails if the debit is already confirmed so a payment can never count twice. */
+    fun confirm(
+        decisions: Map<Long, PaymentDecision>, txn: RotationTxn, card: CardKey, amount: BigDecimal, now: LocalDateTime,
+    ): Map<Long, PaymentDecision> {
+        require(amount.signum() > 0 && amount <= txn.amount) { "Confirmed amount must be above zero and at most the debit" }
+        val old = decisions[txn.id]
+        check(old?.status != PaymentStatus.CONFIRMED) { "This payment is already confirmed" }
+        return decisions + (txn.id to PaymentDecision(
+            txnId = txn.id, status = PaymentStatus.CONFIRMED, card = card, amount = amount,
+            reversalDismissed = old?.reversalDismissed ?: false,
+            history = (old?.history ?: emptyList()) + PaymentEvent(now, PaymentStatus.CONFIRMED, card, amount, "Confirmed by user"),
+        ))
+    }
+
+    fun markStatus(
+        decisions: Map<Long, PaymentDecision>, txnId: Long, status: PaymentStatus, now: LocalDateTime, note: String,
+    ): Map<Long, PaymentDecision> {
+        val old = decisions[txnId]
+        return decisions + (txnId to PaymentDecision(
+            txnId = txnId, status = status,
+            card = old?.card,
+            amount = old?.amount, reversalDismissed = old?.reversalDismissed ?: false,
+            history = (old?.history ?: emptyList()) + PaymentEvent(now, status, old?.card, old?.amount, note),
+        ))
+    }
+
+    /** "That was not a failed payment": keeps it counted and stops automatic reversal for this debit. */
+    fun dismissReversal(decisions: Map<Long, PaymentDecision>, txnId: Long, now: LocalDateTime): Map<Long, PaymentDecision> {
+        val old = decisions[txnId] ?: return decisions
+        return decisions + (txnId to old.copy(reversalDismissed = true,
+            history = old.history + PaymentEvent(now, old.status, old.card, old.amount, "Reversal evidence dismissed by user")))
+    }
+
+    /** The user says this debit was not a card payment (or wants to redo it). History stays. */
+    fun unassign(decisions: Map<Long, PaymentDecision>, txnId: Long, now: LocalDateTime): Map<Long, PaymentDecision> {
+        val old = decisions[txnId] ?: return decisions
+        return decisions + (txnId to PaymentDecision(txnId, PaymentStatus.PENDING, null, null, old.reversalDismissed,
+            old.history + PaymentEvent(now, PaymentStatus.PENDING, null, null, "Unassigned by user")))
+    }
+
+    // ---- outstanding: one source of truth ------------------------------------------------------------------
+
+    fun outstanding(
+        card: CardKey,
+        txns: List<RotationTxn>,
+        rows: List<PaymentRow>,
+        account: CardAccount?,
+        reconciliations: List<Reconciliation>,
+    ): Outstanding {
+        val key = id(card)
+        val recon = reconciliations.filter { id(it.card) == key }.maxByOrNull { it.at }
+        val bank = account?.let { a -> a.outstanding?.let { amt -> a.asOf?.let { amt to it } } }
+        // The newest of the user's reconciliation and the bank's own SMS figure is the anchor.
+        val anchor: Triple<BigDecimal, LocalDateTime, AnchorKind>? = when {
+            recon != null && (bank == null || recon.at >= bank.second) -> Triple(recon.bankOutstanding, recon.at, AnchorKind.RECONCILED)
+            bank != null -> Triple(bank.first, bank.second, AnchorKind.BANK_SMS)
+            else -> null
+        }
+        val after: (LocalDateTime) -> Boolean = { t -> anchor == null || t.isAfter(anchor.second) }
+        val spends = txns.filter { it.kind == RotationKind.CARD_PURCHASE && id(cardKeyOf(it)) == key && after(it.dateTime) }
+            .fold(BigDecimal.ZERO) { a, t -> a + t.amount }
+        val paid = rows.filter { it.status == PaymentStatus.CONFIRMED && it.card?.let(::id) == key && after(it.txn.dateTime) }
+            .fold(BigDecimal.ZERO) { a, r -> a + (r.amount ?: BigDecimal.ZERO) }
+        val base = anchor?.first ?: BigDecimal.ZERO
+        return Outstanding(base + spends - paid, anchor?.third ?: AnchorKind.NONE, anchor?.second, anchor == null, spends, paid)
+    }
+
+    private fun cardKeyOf(t: RotationTxn) =
+        CardKey(t.bankName?.takeIf { it.isNotBlank() } ?: "Card", t.account.orEmpty().filter { it.isDigit() }.takeLast(4))
+
+    fun reconcile(
+        history: List<Reconciliation>, card: CardKey, bankOutstanding: BigDecimal, now: LocalDateTime, calculatedNow: BigDecimal,
+    ): List<Reconciliation> {
+        require(bankOutstanding.signum() >= 0) { "The bank's outstanding amount cannot be negative" }
+        return history + Reconciliation(card, now, bankOutstanding, calculatedNow, bankOutstanding - calculatedNow)
+    }
+
+    // ---- deriving every payment row ---------------------------------------------------------------------------
+
+    fun rows(
+        txns: List<RotationTxn>,
+        cards: List<CardKey>,
+        decisions: Map<Long, PaymentDecision>,
+    ): Pair<List<PaymentRow>, List<PaymentQuestion>> {
+        val debits = txns.filter { it.kind == RotationKind.OUTGOING }.sortedBy { it.dateTime }
+        val candidates = debits.filter { it.id in decisions || evidenceOf(it, cards) != null }
+
+        val base = candidates.map { t ->
+            val ev = evidenceOf(t, cards)
+            val d = decisions[t.id]
+            val suggested = if (isCred(t)) null else cardByLast4(t, cards)
+            when {
+                d != null -> PaymentRow(t, d.status, d.card, d.amount, ev ?: PaymentEvidence.USER_MARKED, PaymentRow.Basis.USER, d.history.lastOrNull()?.note.orEmpty(), d.history, suggested)
+                // Only a full last-four in the SMS settles the card without asking; CRED and NetBanking always ask.
+                ev == PaymentEvidence.CARD_LAST4 && suggested != null ->
+                    PaymentRow(t, PaymentStatus.CONFIRMED, suggested, t.amount, ev, PaymentRow.Basis.EVIDENCE, "Card named in the bank SMS", emptyList(), suggested)
+                else -> PaymentRow(t, PaymentStatus.PENDING, null, null, ev, PaymentRow.Basis.NONE, "Waiting for your confirmation", emptyList(), suggested)
+            }
+        }.toMutableList()
+
+        val questions = ArrayList<PaymentQuestion>()
+
+        // Duplicates. The user's own decision always wins, but one payment must never reduce outstanding twice.
+        val kept = ArrayList<Int>()
+        for (i in base.indices) {
+            val r = base[i]
+            if (r.status == PaymentStatus.DUPLICATE) continue
+            var flagged = false
+            for (j in kept.toList()) {
+                val o = base[j]
+                if (o.status == PaymentStatus.DUPLICATE) continue
+                val kind = duplicateKind(o.txn, r.txn)
+                if (kind == DuplicateKind.NO) continue
+                val auto = "Same payment as another row (matching amount, time and account or reference)"
+                when {
+                    r.basis != PaymentRow.Basis.USER && kind == DuplicateKind.CLEAR -> {
+                        base[i] = r.copy(status = PaymentStatus.DUPLICATE, card = null, amount = null, basis = PaymentRow.Basis.AUTO, note = auto)
+                        flagged = true
+                    }
+                    r.basis == PaymentRow.Basis.USER && o.basis != PaymentRow.Basis.USER && kind == DuplicateKind.CLEAR ->
+                        base[j] = o.copy(status = PaymentStatus.DUPLICATE, card = null, amount = null, basis = PaymentRow.Basis.AUTO, note = auto)
+                    r.status != PaymentStatus.DUPLICATE -> questions += PaymentQuestion.PossibleDuplicate(r.txn.id, o.txn.id)
+                }
+                if (flagged) break
+            }
+            if (!flagged) kept += i
+        }
+
+        // Failed / reversed: clear evidence reverses automatically; uncertain evidence is a question.
+        val credits = txns.filter { it.kind == RotationKind.INCOMING }
+        for (i in base.indices) {
+            val r = base[i]
+            if (r.status != PaymentStatus.CONFIRMED && r.status != PaymentStatus.PENDING) continue
+            if (decisions[r.txn.id]?.reversalDismissed == true) continue
+            val own = "${r.txn.merchant} ${r.txn.text}"
+            if (FAILED_WORDS.containsMatchIn(own)) {
+                base[i] = r.copy(status = PaymentStatus.FAILED, basis = PaymentRow.Basis.AUTO, note = "The bank message says this payment failed")
+                continue
+            }
+            val refs = references(r.txn)
+            var uncertain: RotationTxn? = null
+            var clear: RotationTxn? = null
+            for (c in credits) {
+                if (c.amount.compareTo(r.txn.amount) != 0) continue
+                val gap = Duration.between(r.txn.dateTime, c.dateTime)
+                if (gap.isNegative || gap > Duration.ofDays(7)) continue
+                val ctext = "${c.merchant} ${c.text}"
+                val sameRef = refs.isNotEmpty() && references(c).any { it in refs }
+                if (REVERSED_WORDS.containsMatchIn(ctext) || sameRef) { clear = c; break } else uncertain = uncertain ?: c
+            }
+            when {
+                clear != null -> base[i] = r.copy(status = PaymentStatus.REVERSED, basis = PaymentRow.Basis.AUTO,
+                    note = "A matching credit marked as a reversal or refund was received",
+                    history = r.history + PaymentEvent(clear.dateTime, PaymentStatus.REVERSED, r.card, r.amount, "Reversal evidence in transaction ${clear.id}"))
+                uncertain != null -> questions += PaymentQuestion.PossibleReversal(r.txn.id, uncertain.id, uncertain.dateTime)
+            }
+        }
+        return base.toList() to questions
+    }
+
+    private enum class DuplicateKind { CLEAR, UNCERTAIN, NO }
+
+    private fun references(t: RotationTxn): Set<String> = REFERENCE.findAll("${t.merchant} ${t.text}").map { it.value }.toSet()
+
+    private fun sameAccount(a: RotationTxn, b: RotationTxn): Boolean? {
+        val x = a.account.orEmpty().filter { it.isDigit() }.takeLast(4)
+        val y = b.account.orEmpty().filter { it.isDigit() }.takeLast(4)
+        if (x.isEmpty() || y.isEmpty()) return null
+        return x == y && a.bankName.orEmpty().trim().equals(b.bankName.orEmpty().trim(), ignoreCase = true)
+    }
+
+    private fun duplicateKind(a: RotationTxn, b: RotationTxn): DuplicateKind {
+        if (a.amount.compareTo(b.amount) != 0) return DuplicateKind.NO
+        val gap = Duration.between(a.dateTime, b.dateTime).abs()
+        val sharedRef = references(a).any { it in references(b) }
+        if (sharedRef && gap <= Duration.ofDays(3)) return DuplicateKind.CLEAR
+        val acct = sameAccount(a, b)
+        if (gap <= Duration.ofMinutes(15) && acct != false) return DuplicateKind.CLEAR
+        if (gap <= Duration.ofHours(24)) return DuplicateKind.UNCERTAIN
+        return DuplicateKind.NO
+    }
+
+    // ---- the full report ------------------------------------------------------------------------------------------
+
+    fun report(
+        txns: List<RotationTxn>,
+        accounts: List<CardAccount>,
+        decisions: Map<Long, PaymentDecision>,
+        reconciliations: List<Reconciliation>,
+        schedules: List<CardSchedule>,
+        asOf: LocalDateTime = LocalDateTime.now(),
+    ): PaymentsReport {
+        val spendCards = txns.filter { it.kind == RotationKind.CARD_PURCHASE }.map { cardKeyOf(it) }
+        val cards = (spendCards + accounts.map { CardKey(it.bank, it.last4) } + decisions.values.mapNotNull { it.card }).distinctBy { id(it) }
+        val (rows, questions) = rows(txns, cards, decisions)
+        val month = YearMonth.from(asOf)
+        val today = asOf.toLocalDate()
+        val accountById = accounts.associateBy { norm(it.bank, it.last4) }
+
+        val summaries = cards.map { c ->
+            val key = id(c)
+            val acct = accountById[key]
+            val mine = rows.filter { it.status == PaymentStatus.CONFIRMED && it.card?.let(::id) == key }
+            val out = outstanding(c, txns, rows, acct, reconciliations)
+            val schedule = schedules.firstOrNull { id(it.card) == key }
+            val due = schedule?.dueDay?.let { nextDue(it, today) }
+            val paidAll = mine.fold(BigDecimal.ZERO) { a, r -> a + (r.amount ?: BigDecimal.ZERO) }
+            val paidMonth = mine.filter { YearMonth.from(it.txn.dateTime) == month }.fold(BigDecimal.ZERO) { a, r -> a + (r.amount ?: BigDecimal.ZERO) }
+            CardPaymentSummary(
+                card = c, outstanding = out, limit = acct?.limit, paidMonth = paidMonth, paidAll = paidAll,
+                payments = rows.filter { it.card?.let(::id) == key }.sortedByDescending { it.txn.dateTime },
+                reconciliations = reconciliations.filter { id(it.card) == key }.sortedByDescending { it.at },
+                schedule = schedule, nextDue = due,
+                partiallyPaid = mine.isNotEmpty() && out.amount.signum() > 0,
+                paidInFull = !out.isEstimate && out.amount.signum() <= 0,
+            )
+        }.sortedByDescending { it.outstanding.amount }
+
+        return PaymentsReport(
+            pending = rows.filter { it.status == PaymentStatus.PENDING }.sortedByDescending { it.txn.dateTime },
+            cards = summaries, questions = questions, allRows = rows,
+            confirmedThisMonth = rows.filter { it.status == PaymentStatus.CONFIRMED && YearMonth.from(it.txn.dateTime) == month }
+                .fold(BigDecimal.ZERO) { a, r -> a + (r.amount ?: BigDecimal.ZERO) },
+        )
+    }
+
+    private fun norm(bank: String?, last4: String) = "${bank.orEmpty().trim().lowercase()}|$last4"
+
+    // ---- due dates and reminders ------------------------------------------------------------------------------------
+
+    /** The next date on or after [today] that falls on [dueDay], clamped to short months. */
+    fun nextDue(dueDay: Int, today: LocalDate): LocalDate {
+        val thisMonth = today.withDayOfMonth(minOf(dueDay, today.lengthOfMonth()))
+        if (!thisMonth.isBefore(today)) return thisMonth
+        val next = today.plusMonths(1)
+        return next.withDayOfMonth(minOf(dueDay, next.lengthOfMonth()))
+    }
+
+    private fun previousDue(dueDay: Int, today: LocalDate): LocalDate {
+        val thisMonth = today.withDayOfMonth(minOf(dueDay, today.lengthOfMonth()))
+        if (thisMonth.isBefore(today)) return thisMonth
+        val prev = today.minusMonths(1)
+        return prev.withDayOfMonth(minOf(dueDay, prev.lengthOfMonth()))
+    }
+
+    /**
+     * Alerts that should be raised today. Each has a stable key; pass the keys already sent and nothing repeats.
+     * Nothing is raised for a card whose outstanding is known to be cleared. A partial payment lowers the amount
+     * but does not silence the alerts.
+     */
+    fun dueAlerts(
+        schedules: List<CardSchedule>, outstanding: Map<String, Outstanding>, today: LocalDate, alreadySent: Set<String>,
+    ): List<DueAlert> {
+        val out = ArrayList<DueAlert>()
+        for (s in schedules) {
+            val day = s.dueDay ?: continue
+            val o = outstanding[id(s.card)]
+            val owes = o == null || o.isEstimate || o.amount.signum() > 0
+            if (!owes) continue
+            val due = nextDue(day, today)
+            fun add(kind: DueAlertKind, date: LocalDate, n: Int?) {
+                val key = "${id(s.card)}|$date|${kind.name}${n ?: ""}"
+                if (key !in alreadySent) out += DueAlert(s.card, kind, date, n, key)
+            }
+            for (n in s.remindDaysBefore.filter { it > 0 }.distinct()) if (today == due.minusDays(n.toLong())) add(DueAlertKind.BEFORE, due, n)
+            if (s.remindOnDue && today == due) add(DueAlertKind.ON_DUE, due, null)
+            if (s.overdueAlerts) {
+                val prev = previousDue(day, today)
+                if (prev.isBefore(today) && Duration.between(prev.atStartOfDay(), today.atStartOfDay()).toDays() <= 14) add(DueAlertKind.OVERDUE, prev, null)
+            }
+        }
+        return out
+    }
+}
