+import java.math.BigDecimal
+import java.text.NumberFormat
+import java.time.format.DateTimeFormatter
+import java.util.Locale
+
+private val inr: NumberFormat = NumberFormat.getCurrencyInstance(Locale.Builder().setLanguage("en").setRegion("IN").build())
+private val dayFmt: DateTimeFormatter = DateTimeFormatter.ofPattern("d MMM, h:mm a")
+private fun money(v: BigDecimal): String = inr.format(v)
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun CreditCardsScreen(
+    onNavigateBack: () -> Unit,
+    onOpenRotation: () -> Unit,
+    onOpenPayments: () -> Unit,
+    viewModel: CreditCardsViewModel = hiltViewModel(),
+) {
+    val state by viewModel.uiState.collectAsStateWithLifecycle()
+    val report = state.report
+    var showAll by remember { mutableStateOf(false) }
+    var expanded by remember { mutableStateOf(setOf<String>()) }
+
+    Scaffold(
+        topBar = {
+            TopAppBar(
+                title = { Text("Credit cards") },
+                navigationIcon = {
+                    IconButton(onClick = onNavigateBack) {
+                        Icon(Icons.AutoMirrored.Filled.ArrowBack, contentDescription = "Back")
+                    }
+                },
+            )
+        },
+    ) { padding ->
+        LazyColumn(
+            modifier = Modifier.padding(padding),
+            contentPadding = PaddingValues(16.dp),
+            verticalArrangement = Arrangement.spacedBy(12.dp),
+        ) {
+            if (report == null || report.cards.isEmpty()) {
+                item {
+                    Text(
+                        if (state.isLoading) "Loading…" else "No credit-card spends found yet. They appear here once PennyWise reads your card SMS.",
+                        style = MaterialTheme.typography.bodyMedium,
+                    )
+                }
+            } else {
+                item {
+                    Card(modifier = Modifier.fillMaxWidth()) {
+                        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+                            Text("All cards · this month", style = MaterialTheme.typography.titleMedium, fontWeight = FontWeight.SemiBold)
+                            Line("Spent", money(report.spentMonth))
+                            Line("Paid to cards (confirmed)", money(report.confirmedPaidThisMonth))
+                            Line("Outstanding now", money(report.outstanding), emphasize = true)
+                            if (report.rotationCharges.signum() > 0) Line("Rotation charges paid", money(report.rotationCharges))
+                            Text(
+                                if (report.hasEstimates) "Some cards show an estimate because there is no bank figure yet. Open Card payments and reconcile."
+                                else "Outstanding comes from the bank's figure plus later spends minus later confirmed payments.",
+                                style = MaterialTheme.typography.bodySmall,
+                            )
+                            if (report.pending.isNotEmpty() || report.questions > 0) {
+                                Text(
+                                    "${report.pending.size} payment(s) worth ${money(report.pendingAmount)} wait for your confirmation" +
+                                        (if (report.questions > 0) " and ${report.questions} need a check." else "."),
+                                    style = MaterialTheme.typography.bodyMedium,
+                                    fontWeight = FontWeight.SemiBold,
+                                )
+                            }
+                        }
+                    }
+                }
+                item {
+                    Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                        if (!showAll) Button(onClick = { showAll = false }) { Text("This month") }
+                        else OutlinedButton(onClick = { showAll = false }) { Text("This month") }
+                        if (showAll) Button(onClick = { showAll = true }) { Text("All time") }
+                        else OutlinedButton(onClick = { showAll = true }) { Text("All time") }
+                        OutlinedButton(onClick = onOpenPayments) { Text("Card payments") }
+                        OutlinedButton(onClick = onOpenRotation) { Text("Card rotation") }
+                    }
+                }
+                items(report.cards, key = { it.card.label }) { c ->
+                    val open = c.card.label in expanded
+                    CardBlock(
+                        c = c,
+                        showAll = showAll,
+                        open = open,
+                        onToggle = { expanded = if (open) expanded - c.card.label else expanded + c.card.label },
+                    )
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun CardBlock(c: CardSummary, showAll: Boolean, open: Boolean, onToggle: () -> Unit) {
+    Card(modifier = Modifier.fillMaxWidth()) {
+        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+            Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
+                Text(c.card.label, style = MaterialTheme.typography.titleMedium, fontWeight = FontWeight.SemiBold)
+                c.usedPercent?.let { Text("$it% used", style = MaterialTheme.typography.bodyMedium) }
+            }
+            Line(if (showAll) "Spent (all time)" else "Spent this month", money(if (showAll) c.spentAll else c.spentMonth))
+            Line(if (showAll) "Paid (all time)" else "Paid this month", money(if (showAll) c.paidAll else c.paidMonth))
+            if (c.outstanding.isEstimate) {
+                Line("Outstanding (estimate)", money(c.outstanding.amount.max(BigDecimal.ZERO)), emphasize = true)
+                Text("History is incomplete, so this is not exact. Reconcile on the Card payments screen.", style = MaterialTheme.typography.bodySmall)
+            } else {
+                Line("Outstanding", money(c.outstanding.amount.max(BigDecimal.ZERO)), emphasize = true)
+                c.limit?.let { Line("Available credit", money((it - c.outstanding.amount).max(BigDecimal.ZERO))) }
+            }
+            if (c.partiallyPaid) Text("Partly paid. A partial payment does not clear the bill.", style = MaterialTheme.typography.bodySmall)
+            else if (c.paidInFull) Text("Paid in full.", style = MaterialTheme.typography.bodySmall)
+            if (c.rotated.signum() > 0) {
+                HorizontalDivider(Modifier.padding(vertical = 2.dp))
+                Line("Rotated through gateways", money(c.rotated))
+                Line("Rotation charges", money(c.rotationCharges), emphasize = true)
+            }
+            if (c.activity.isNotEmpty()) {
+                TextButton(onClick = onToggle) { Text(if (open) "Hide activity" else "Show activity") }
+            }
+            if (open) c.activity.forEach { ActivityRow(it) }
+        }
+    }
+}
+
+@Composable
+private fun ActivityRow(a: CardActivity) {
+    val label = when (a.kind) {
+        ActivityKind.SPEND -> "Spent"
+        ActivityKind.PAYMENT -> when (a.status) {
+            PaymentStatus.REVERSED -> "Payment reversed"
+            PaymentStatus.FAILED -> "Payment failed"
+            PaymentStatus.DUPLICATE -> "Duplicate payment, not counted"
+            PaymentStatus.PENDING -> "Payment waiting for confirmation"
+            else -> "Paid"
+        }
+        ActivityKind.ROTATION_SPEND -> "Rotation spend"
+        ActivityKind.ROTATION_CREDIT -> "Rotation credit to bank"
+        ActivityKind.ROTATION_ONWARD -> "Rotation: paid onward"
+    }
+    Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
+        Column(Modifier.weight(1f)) {
+            Text(a.title, style = MaterialTheme.typography.bodyMedium, maxLines = 1)
+            Text("$label · ${a.at.format(dayFmt)}", style = MaterialTheme.typography.bodySmall)
+        }
+        Text(money(a.amount), style = MaterialTheme.typography.bodyMedium)
+    }
+}
+
+@Composable
+private fun Line(label: String, value: String, emphasize: Boolean = false) {
+    Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
+        Text(label, style = MaterialTheme.typography.bodyMedium)
+        Text(value, style = MaterialTheme.typography.bodyMedium, fontWeight = if (emphasize) FontWeight.SemiBold else FontWeight.Normal)
+    }
+}
