+import java.text.NumberFormat
+import java.time.format.DateTimeFormatter
+import java.util.Locale
+
+private val inr: NumberFormat = NumberFormat.getCurrencyInstance(Locale.Builder().setLanguage("en").setRegion("IN").build())
+private val whenFmt: DateTimeFormatter = DateTimeFormatter.ofPattern("d MMM, h:mm a")
+private fun money(v: BigDecimal): String = inr.format(v)
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun CardRotationScreen(
+    onNavigateBack: () -> Unit,
+    viewModel: CardRotationViewModel = hiltViewModel(),
+) {
+    val state by viewModel.uiState.collectAsStateWithLifecycle()
+    val report = state.report
+    var creditTarget by remember { mutableStateOf<CreditTarget?>(null) }
+    val context = LocalContext.current
+    LaunchedEffect(Unit) {
+        viewModel.messages.collect { Toast.makeText(context, it, Toast.LENGTH_LONG).show() }
+    }
+
+    creditTarget?.let { target ->
+        MissingCreditDialog(
+            target = target,
+            accounts = state.accounts,
+            onDismiss = { creditTarget = null },
+            onSave = { amount, account ->
+                if (viewModel.addMissingCredit(target.outId, target.spent, target.at, amount, account)) creditTarget = null
+            },
+        )
+    }
+
+    Scaffold(
+        topBar = {
+            TopAppBar(
+                title = { Text("Card rotation") },
+                navigationIcon = {
+                    IconButton(onClick = onNavigateBack) {
+                        Icon(Icons.AutoMirrored.Filled.ArrowBack, contentDescription = "Back")
+                    }
+                },
+            )
+        },
+    ) { padding ->
+        LazyColumn(
+            modifier = Modifier.padding(padding),
+            contentPadding = PaddingValues(16.dp),
+            verticalArrangement = Arrangement.spacedBy(12.dp),
+        ) {
+            item {
+                Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
+                    Column(Modifier.weight(1f)) {
+                        Text("Remind me about card spends with no credit")
+                        Text(
+                            "A notification once a spend has waited 45 minutes with no matching credit.",
+                            style = MaterialTheme.typography.bodySmall,
+                        )
+                    }
+                    Switch(checked = state.remindersEnabled, onCheckedChange = viewModel::setRemindersEnabled)
+                }
+            }
+            item {
+                var minText by remember(state.askMinAmount) { mutableStateOf(state.askMinAmount.toString()) }
+                OutlinedTextField(
+                    value = minText,
+                    onValueChange = { v ->
+                        val digits = v.filter { it.isDigit() }.take(7)
+                        minText = digits
+                        viewModel.setAskMinAmount(digits.toIntOrNull() ?: 0)
+                    },
+                    label = { Text("Ask about card spends of at least (₹)") },
+                    supportingText = { Text("0 asks about every spend. Small everyday spends are usually not rotations.") },
+                    singleLine = true,
+                    keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+                    modifier = Modifier.fillMaxWidth(),
+                )
+            }
+            item {
+                var hoursText by remember(state.windowHours) { mutableStateOf(state.windowHours.toString()) }
+                OutlinedTextField(
+                    value = hoursText,
+                    onValueChange = { v ->
+                        val digits = v.filter { it.isDigit() }.take(3)
+                        hoursText = digits
+                        digits.toIntOrNull()?.let { if (it in 1..168) viewModel.setWindowHours(it) }
+                    },
+                    label = { Text("Match window (hours)") },
+                    supportingText = { Text("How close a bank credit must be to a card spend to be a candidate. A guess, never proof. Default 24.") },
+                    singleLine = true,
+                    keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+                    modifier = Modifier.fillMaxWidth(),
+                )
+            }
+            if (report != null && report.suggestions.isNotEmpty()) {
+                item {
+                    Text(
+                        "Credit SMS missing? Confirm what these were",
+                        style = MaterialTheme.typography.titleMedium,
+                        fontWeight = FontWeight.SemiBold,
+                    )
+                }
+                items(report.suggestions, key = { it.outId }) { s ->
+                    SuggestionCard(
+                        s,
+                        onEnterCredit = { creditTarget = CreditTarget(s.outId, s.spent, s.at, s.card.label) },
+                        onTransfer = { viewModel.confirmSuggestion(s, OnwardUse.TRANSFER) },
+                        onExpense = { viewModel.confirmSuggestion(s, OnwardUse.EXPENSE) },
+                        onDismiss = { viewModel.dismissSuggestion(s.outId) },
+                    )
+                }
+            }
+            if (report != null && report.needsCredit.isNotEmpty()) {
+                item {
+                    Text(
+                        "Was a credit missed? (${report.needsCredit.size})",
+                        style = MaterialTheme.typography.titleMedium,
+                        fontWeight = FontWeight.SemiBold,
+                    )
+                    Text(
+                        "These card spends have no matching bank credit. If it was a rotation, enter what actually arrived.",
+                        style = MaterialTheme.typography.bodySmall,
+                    )
+                }
+                items(report.needsCredit, key = { "need-${it.outId}" }) { u ->
+                    UnmatchedCard(
+                        u,
+                        onYes = { creditTarget = CreditTarget(u.outId, u.spent, u.at, u.card.label) },
+                        onNo = { viewModel.dismissSuggestion(u.outId) },
+                    )
+                }
+            }
+            if (report == null || report.cards.isEmpty()) {
+                item {
+                    Text(
+                        if (state.isLoading) "Loading…"
+                        else "No card rotations found yet. A rotation is a credit-card spend at a payment gateway " +
+                            "(Cashfree, Razorpay, PayU…) followed by a slightly smaller credit in your bank account.",
+                        style = MaterialTheme.typography.bodyMedium,
+                    )
+                }
+            } else {
+                item {
+                    Card(modifier = Modifier.fillMaxWidth()) {
+                        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+                            Text("All cards", style = MaterialTheme.typography.titleMedium, fontWeight = FontWeight.SemiBold)
+                            Line("Rotated (card spend)", money(report.totalRotated))
+                            Line("Received in bank", money(report.totalReceived))
+                            Line("Charges paid", money(report.totalCharges), emphasize = true)
+                            HorizontalDivider(Modifier.padding(vertical = 4.dp))
+                            Row(verticalAlignment = Alignment.CenterVertically) {
+                                Column(Modifier.weight(1f)) {
+                                    Text("Hide rotation from income & expenses")
+                                    Text(
+                                        "Excludes both legs from totals. Charges stay visible here.",
+                                        style = MaterialTheme.typography.bodySmall,
+                                    )
+                                }
+                                Switch(checked = state.rotationHidden, onCheckedChange = viewModel::setRotationHidden)
+                            }
+                        }
+                    }
+                }
+                items(report.cards, key = { it.card.label }) { ledger -> CardSection(ledger, onUnlink = viewModel::unlink) }
+                if (report.unassignedRepaymentIds.isNotEmpty()) {
+                    item {
+                        Text(
+                            "${report.unassignedRepaymentIds.size} card-bill payment(s) worth ${money(report.unassignedRepaid)} " +
+                                "could not be tied to a card (no matching last 4 digits in the SMS).",
+                            style = MaterialTheme.typography.bodySmall,
+                        )
+                    }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun CardSection(ledger: CardLedger, onUnlink: (RotationPair) -> Unit) {
+    Card(modifier = Modifier.fillMaxWidth(), colors = CardDefaults.cardColors()) {
+        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+            Text(ledger.card.label, style = MaterialTheme.typography.titleMedium, fontWeight = FontWeight.SemiBold)
+            Line("Rotated", money(ledger.rotated))
+            Line("Received in bank", money(ledger.received))
+            Line("Charges", "${money(ledger.charges)} (${ledger.chargePct}%)", emphasize = true)
+            if (ledger.hasEstimates) {
+                Text("Includes estimates where the bank credit SMS was missing.", style = MaterialTheme.typography.bodySmall)
+            }
+            Line("Paid back to this card", money(ledger.repaid))
+            Line("Still to repay (rotation)", money(ledger.stillToRepay), emphasize = true)
+            HorizontalDivider(Modifier.padding(vertical = 4.dp))
+            ledger.rotations.sortedByDescending { it.at }.forEach { p ->
+                Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
+                    Column {
+                        Text(p.at.format(whenFmt), style = MaterialTheme.typography.bodySmall)
+                        Text("${money(p.spent)} → ${money(p.received)}", style = MaterialTheme.typography.bodyMedium)
+                    }
+                    Column(horizontalAlignment = Alignment.End) {
+                        Text("−${money(p.charges)}" + if (p.inferred) " (est.)" else "", style = MaterialTheme.typography.bodyMedium)
+                        if (p.inferred) TextButton(onClick = { onUnlink(p) }) { Text("Unlink") }
+                    }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun Line(label: String, value: String, emphasize: Boolean = false) {
+    Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
+        Text(label, style = MaterialTheme.typography.bodyMedium)
+        Text(
+            value,
+            style = MaterialTheme.typography.bodyMedium,
+            fontWeight = if (emphasize) FontWeight.SemiBold else FontWeight.Normal,
+        )
+    }
+}
+
+@Composable
+private fun SuggestionCard(
+    s: RotationSuggestion,
+    onEnterCredit: () -> Unit,
+    onTransfer: () -> Unit,
+    onExpense: () -> Unit,
+    onDismiss: () -> Unit,
+) {
+    Card(modifier = Modifier.fillMaxWidth()) {
+        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+            Text(s.card.label, style = MaterialTheme.typography.titleSmall, fontWeight = FontWeight.SemiBold)
+            Text("${money(s.spent)} spent on card · ${s.at.format(whenFmt)}", style = MaterialTheme.typography.bodyMedium)
+            Text("${money(s.onward)} left your bank · ${s.onwardAt.format(whenFmt)}", style = MaterialTheme.typography.bodyMedium)
+            Text("Estimated charges ${money(s.estCharges)}", style = MaterialTheme.typography.bodySmall)
+            Text("What was the bank debit?", style = MaterialTheme.typography.bodySmall)
+            if (s.looksLikeCardBill) Text("It looks like a credit-card bill payment.", style = MaterialTheme.typography.bodySmall)
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                Button(onClick = onTransfer) { Text("Card bill / own account") }
+                OutlinedButton(onClick = onExpense) { Text("Real expense") }
+            }
+            Row {
+                TextButton(onClick = onEnterCredit) { Text("Credit was missing instead") }
+                TextButton(onClick = onDismiss) { Text("Not a rotation") }
+            }
+        }
+    }
+}
+
+private data class CreditTarget(val outId: Long, val spent: BigDecimal, val at: LocalDateTime, val cardLabel: String)
+
+@Composable
+private fun UnmatchedCard(u: UnmatchedSpend, onYes: () -> Unit, onNo: () -> Unit) {
+    Card(modifier = Modifier.fillMaxWidth()) {
+        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(4.dp)) {
+            Text("${money(u.spent)} · ${u.merchant}", style = MaterialTheme.typography.bodyLarge, fontWeight = FontWeight.SemiBold)
+            Text("${u.card.label} · ${u.at.format(whenFmt)}", style = MaterialTheme.typography.bodySmall)
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                Button(onClick = onYes) { Text("Yes, add credit") }
+                OutlinedButton(onClick = onNo) { Text("Not a rotation") }
+            }
+        }
+    }
+}
+
+@Composable
+private fun MissingCreditDialog(
+    target: CreditTarget,
+    accounts: List<com.pennywiseai.tracker.data.database.entity.AccountBalanceEntity>,
+    onDismiss: () -> Unit,
+    onSave: (BigDecimal, com.pennywiseai.tracker.data.database.entity.AccountBalanceEntity?) -> Unit,
+) {
+    var amountText by remember { mutableStateOf("") }
+    var account by remember { mutableStateOf<com.pennywiseai.tracker.data.database.entity.AccountBalanceEntity?>(null) }
+    val amount = amountText.replace(",", "").toBigDecimalOrNull()
+    val valid = amount != null && amount.signum() > 0 && amount <= target.spent
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text("Credit that arrived") },
+        text = {
+            Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                Text("${money(target.spent)} was spent on ${target.cardLabel}. How much actually reached your account?")
+                OutlinedTextField(
+                    value = amountText,
+                    onValueChange = { amountText = it },
+                    label = { Text("Amount received") },
+                    singleLine = true,
+                    keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Decimal),
+                    isError = amountText.isNotEmpty() && !valid,
+                    supportingText = {
+                        if (valid && amount != null) Text("Charges: ${money(target.spent - amount)}")
+                        else if (amountText.isNotEmpty()) Text("Enter more than 0 and at most ${money(target.spent)}")
+                    },
+                )
+                Text("Credited to", style = MaterialTheme.typography.bodySmall)
+                Row(Modifier.fillMaxWidth().clickable { account = null }, verticalAlignment = Alignment.CenterVertically) {
+                    RadioButton(selected = account == null, onClick = { account = null })
+                    Text("Not sure / skip account")
+                }
+                accounts.forEach { a ->
+                    Row(Modifier.fillMaxWidth().clickable { account = a }, verticalAlignment = Alignment.CenterVertically) {
+                        RadioButton(selected = account?.let { it.bankName == a.bankName && it.accountLast4 == a.accountLast4 } == true, onClick = { account = a })
+                        Text("${a.alias ?: a.bankName} ••${a.accountLast4}")
+                    }
+                }
+            }
+        },
+        confirmButton = { Button(enabled = valid, onClick = { amount?.let { onSave(it, account) } }) { Text("Save") } },
+        dismissButton = { TextButton(onClick = onDismiss) { Text("Cancel") } },
+    )
+}
