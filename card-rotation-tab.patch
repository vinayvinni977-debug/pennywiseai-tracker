+package com.pennywiseai.tracker.domain.rotation
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.math.BigDecimal
+import java.time.LocalDateTime
+
+class CardRotationTest {
+
+    private val t0 = LocalDateTime.of(2026, 10, 18, 22, 36)
+
+    private fun txn(
+        id: Long, kind: RotationKind, amount: String, merchant: String,
+        min: Long = 0, bank: String? = null, acct: String? = null, text: String = "",
+    ) = RotationTxn(id, BigDecimal(amount), merchant, kind, t0.plusMinutes(min), bank, acct, text)
+
+    private fun card(id: Long, amount: String, merchant: String = "Cas*scapic Innovations", min: Long = 0, acct: String = "4321") =
+        txn(id, RotationKind.CARD_PURCHASE, amount, merchant, min, "HDFC", acct)
+
+    private fun income(id: Long, amount: String, merchant: String = "Cashfree Payments in your Kotak811 a/c", min: Long = 1) =
+        txn(id, RotationKind.INCOMING, amount, merchant, min, "Kotak", "0811")
+
+    /** The exact screenshot: 50,584.10 on the card, 50,000 lands in the bank one minute later. */
+    @Test
+    fun screenshotCase_isPairedAndChargesAreTheDifference() {
+        val r = CardRotation.analyze(listOf(card(1, "50584.10"), income(2, "50000")))
+        assertEquals(1, r.cards.size)
+        val c = r.cards.single()
+        assertEquals(BigDecimal("584.10"), c.charges)
+        assertEquals(BigDecimal("1.17"), c.chargePct)
+        assertEquals(setOf(1L, 2L), r.pairedIds)
+        assertEquals("HDFC ••4321", c.card.label)
+    }
+
+    @Test
+    fun plainCoincidenceWithoutGateway_isNotPaired() {
+        val r = CardRotation.analyze(listOf(card(1, "50000", merchant = "Croma"), income(2, "49900", merchant = "Salary ACME")))
+        assertTrue(r.cards.isEmpty())
+    }
+
+    @Test
+    fun incomeLargerThanSpend_isNotPaired() {
+        val r = CardRotation.analyze(listOf(card(1, "50000"), income(2, "50100")))
+        assertTrue(r.cards.isEmpty())
+    }
+
+    @Test
+    fun hugeDifference_isNotPaired() {
+        val r = CardRotation.analyze(listOf(card(1, "50000"), income(2, "40000")))
+        assertTrue(r.cards.isEmpty())
+    }
+
+    @Test
+    fun sameAccountOnBothLegs_isNotPaired() {
+        val bad = RotationTxn(2, BigDecimal("50000"), "Cashfree Payments", RotationKind.INCOMING, t0.plusMinutes(1), "HDFC", "4321")
+        assertTrue(CardRotation.analyze(listOf(card(1, "50584.10"), bad)).cards.isEmpty())
+    }
+
+    @Test
+    fun matchingIsOneToOne_andPicksClosestInTime() {
+        val r = CardRotation.analyze(
+            listOf(
