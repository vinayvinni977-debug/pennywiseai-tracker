+package com.pennywiseai.tracker.presentation.rotation
+
+import android.content.Context
+import com.pennywiseai.tracker.domain.rotation.CardSchedule
+import com.pennywiseai.tracker.domain.rotation.PaymentCodec
+import com.pennywiseai.tracker.domain.rotation.PaymentDecision
+import com.pennywiseai.tracker.domain.rotation.Reconciliation
+import com.pennywiseai.tracker.domain.rotation.ManualLink
+import com.pennywiseai.tracker.domain.rotation.OnwardUse
+
+/**
+ * Small SharedPreferences-backed store shared by the Card rotation screen and the reminder worker, so this
+ * feature needs no Room migration. Not part of the app's backup: reinstalling clears it.
+ *
+ * Link format: "outId:onwardId:T|E". Dismissed / notified: sets of card-spend transaction ids.
+ */
+class CardRotationStore(context: Context) {
+    private val prefs = context.applicationContext.getSharedPreferences(NAME, Context.MODE_PRIVATE)
+
+    fun links(): List<ManualLink> =
+        prefs.getStringSet(KEY_LINKS, emptySet()).orEmpty().mapNotNull { raw ->
+            val p = raw.split(":")
+            val out = p.getOrNull(0)?.toLongOrNull() ?: return@mapNotNull null
+            val onward = p.getOrNull(1)?.toLongOrNull() ?: return@mapNotNull null
+            ManualLink(out, onward, if (p.getOrNull(2) == "E") OnwardUse.EXPENSE else OnwardUse.TRANSFER)
+        }
+
+    fun saveLinks(v: List<ManualLink>) {
+        prefs.edit().putStringSet(
+            KEY_LINKS,
+            v.map { "${it.outId}:${it.onwardId}:${if (it.use == OnwardUse.TRANSFER) "T" else "E"}" }.toSet(),
+        ).apply()
+    }
+
+    fun dismissed(): Set<Long> = longs(KEY_DISMISSED)
+
+    fun saveDismissed(v: Set<Long>) {
+        prefs.edit().putStringSet(KEY_DISMISSED, v.map { it.toString() }.toSet()).apply()
+    }
+
+    /** Spends the user was already reminded about, so each one is announced once. */
+    fun notified(): Set<Long> = longs(KEY_NOTIFIED)
+
+    fun addNotified(ids: Collection<Long>) {
+        // Keep the newest few hundred so the set cannot grow forever.
+        val merged = (notified() + ids).toList().takeLast(MAX_NOTIFIED)
+        prefs.edit().putStringSet(KEY_NOTIFIED, merged.map { it.toString() }.toSet()).apply()
+    }
+
+    /** "Remind me about card spends with no credit"; on by default. */
+    var remindersEnabled: Boolean
+        get() = prefs.getBoolean(KEY_REMIND, true)
+        set(value) { prefs.edit().putBoolean(KEY_REMIND, value).apply() }
+
+    /** Smallest card spend the app asks "was a credit missed?" about. 0 means every spend. */
+    var askMinAmount: Int
+        get() = prefs.getInt(KEY_ASK_MIN, DEFAULT_ASK_MIN)
+        set(value) { prefs.edit().putInt(KEY_ASK_MIN, value.coerceAtLeast(0)).apply() }
+
+    /** Hours either side of a card spend in which a bank credit counts as a candidate. A heuristic, default 24. */
+    var windowHours: Int
+        get() = prefs.getInt(KEY_WINDOW, DEFAULT_WINDOW_HOURS)
+        set(value) { prefs.edit().putInt(KEY_WINDOW, value.coerceIn(1, 168)).apply() }
+
+    // ---- credit-card bill payments: the user's decisions (see CardPayments) -------------------------------
+
+    /** Confirmed / failed / reversed / unassigned payments, with their history. Pending ones are not stored. */
+    fun paymentDecisions(): Map<Long, PaymentDecision> =
+        PaymentCodec.decodeDecisions(prefs.getStringSet(KEY_PAY_DECISIONS, emptySet()).orEmpty())
+
+    fun savePaymentDecisions(v: Map<Long, PaymentDecision>) {
+        prefs.edit().putStringSet(KEY_PAY_DECISIONS, v.values.map { PaymentCodec.encode(it) }.toSet()).apply()
+    }
+
+    /** Every time the user entered the bank's actual outstanding; history is never overwritten. */
+    fun reconciliations(): List<Reconciliation> =
+        prefs.getStringSet(KEY_RECON, emptySet()).orEmpty().mapNotNull { PaymentCodec.decodeReconciliation(it) }
+
+    fun saveReconciliations(v: List<Reconciliation>) {
+        prefs.edit().putStringSet(KEY_RECON, v.map { PaymentCodec.encode(it) }.toSet()).apply()
+    }
+
+    /** Due day and reminder choices, one per card. */
+    fun schedules(): List<CardSchedule> =
+        prefs.getStringSet(KEY_SCHEDULES, emptySet()).orEmpty().mapNotNull { PaymentCodec.decodeSchedule(it) }
+
+    fun saveSchedules(v: List<CardSchedule>) {
+        prefs.edit().putStringSet(KEY_SCHEDULES, v.map { PaymentCodec.encode(it) }.toSet()).apply()
+    }
+
+    /** Debits the user said are NOT card payments, so they are not asked about again. */
+    fun notCardPayments(): Set<Long> = longs(KEY_NOT_PAYMENT)
+
+    fun saveNotCardPayments(v: Set<Long>) {
+        prefs.edit().putStringSet(KEY_NOT_PAYMENT, v.map { it.toString() }.toSet()).apply()
+    }
+
+    /** "Keep both" answers to possible-duplicate and possible-reversal questions. */
+    fun answeredQuestions(): Set<String> = prefs.getStringSet(KEY_ANSWERED, emptySet()).orEmpty()
+
+    fun saveAnsweredQuestions(v: Set<String>) {
+        prefs.edit().putStringSet(KEY_ANSWERED, v).apply()
+    }
+
+    /** Due-date alerts already shown (stable keys), so each is announced once. */
+    fun dueAlertsSent(): Set<String> = prefs.getStringSet(KEY_DUE_SENT, emptySet()).orEmpty()
+
+    fun addDueAlertsSent(keys: Collection<String>) {
+        val merged = (dueAlertsSent() + keys).toList().takeLast(MAX_NOTIFIED)
+        prefs.edit().putStringSet(KEY_DUE_SENT, merged.toSet()).apply()
+    }
+
+    private fun longs(key: String): Set<Long> =
+        prefs.getStringSet(key, emptySet()).orEmpty().mapNotNull { it.toLongOrNull() }.toSet()
+
+    private companion object {
+        const val NAME = "card_rotation"
+        const val KEY_LINKS = "links"
+        const val KEY_DISMISSED = "dismissed"
+        const val KEY_NOTIFIED = "notified"
+        const val KEY_REMIND = "reminders"
+        const val KEY_ASK_MIN = "ask_min"
+        const val KEY_WINDOW = "window_hours"
+        const val KEY_PAY_DECISIONS = "pay_decisions"
+        const val KEY_RECON = "reconciliations"
+        const val KEY_SCHEDULES = "schedules"
+        const val KEY_NOT_PAYMENT = "not_payment"
+        const val KEY_ANSWERED = "answered_questions"
+        const val KEY_DUE_SENT = "due_alerts_sent"
+        const val DEFAULT_ASK_MIN = 5000
+        const val DEFAULT_WINDOW_HOURS = 24
+        const val MAX_NOTIFIED = 500
+    }
+}
