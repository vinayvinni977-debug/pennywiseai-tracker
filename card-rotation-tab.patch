+class CreditReminderTest {
+    private val base = LocalDateTime.of(2026, 10, 18, 13, 0)
+
+    private fun spend(id: Long, at: LocalDateTime, amount: String = "10500") =
+        RotationTxn(id, BigDecimal(amount), "Shop", RotationKind.CARD_PURCHASE, at, "HDFC", "4321")
+
+    private fun report(vararg t: RotationTxn, now: LocalDateTime) = CardRotation.analyze(t.toList(), asOf = now)
+
+    @Test
+    fun notYetDue_untilTheCreditSmsHadTimeToArrive() {
+        val s = spend(1, base)
+        assertTrue(CreditReminder.due(report(s, now = base.plusMinutes(30)), emptySet(), base.plusMinutes(30)).isEmpty())
+        assertEquals(listOf(1L), CreditReminder.due(report(s, now = base.plusMinutes(46)), emptySet(), base.plusMinutes(46)).map { it.outId })
+    }
+
+    @Test
+    fun neverNotifiedTwice() {
+        val now = base.plusHours(2)
+        assertTrue(CreditReminder.due(report(spend(1, base), now = now), setOf(1L), now).isEmpty())
+    }
+
+    @Test
+    fun waitsForTheMorning_andOldSpendsAreSkipped() {
+        val late = base.withHour(23)
+        assertTrue(CreditReminder.due(report(spend(1, base), now = late), emptySet(), late).isEmpty())
+        val morning = base.plusDays(1).withHour(9)
+        assertEquals(listOf(1L), CreditReminder.due(report(spend(1, base), now = morning), emptySet(), morning).map { it.outId })
+        val old = base.plusDays(10)
+        assertTrue(CreditReminder.due(report(spend(1, base), now = old), emptySet(), old).isEmpty())
+    }
+
+    @Test
+    fun resolvedSpendsAreNotReminded() {
+        val now = base.plusHours(2)
+        val credit = RotationTxn(2, BigDecimal("10000"), CardRotation.MANUAL_CREDIT_MERCHANT, RotationKind.INCOMING, base.plusMinutes(1), "Kotak", "0811", "Credit entered by hand for card spend #1")
+        assertTrue(CreditReminder.due(report(spend(1, base), credit, now = now), emptySet(), now).isEmpty())
+        val dismissed = CardRotation.analyze(listOf(spend(1, base)), dismissedOutIds = setOf(1L), asOf = now)
+        assertTrue(CreditReminder.due(dismissed, emptySet(), now).isEmpty())
+    }
+
+    @Test
+    fun unconfirmedSuggestionsAlsoRemind_once() {
+        val now = base.plusHours(3)
+        val debit = RotationTxn(2, BigDecimal("10000"), "UPI", RotationKind.OUTGOING, base.plusMinutes(100), "Kotak", "0811")
+        val r = report(spend(1, base), debit, now = now)
+        assertEquals(1, r.suggestions.size)
+        assertEquals(listOf(1L), CreditReminder.due(r, emptySet(), now).map { it.outId })
+    }
+}
