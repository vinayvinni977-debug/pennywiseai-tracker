+
+data class CardRotationUiState(
+    val report: RotationReport? = null,
+    /** True when every rotation leg is currently excluded from income/expense totals. */
+    val rotationHidden: Boolean = false,
+    val isLoading: Boolean = true,
+    /** Bank accounts the user can say a missing credit landed in (credit cards excluded). */
+    val accounts: List<AccountBalanceEntity> = emptyList(),
+    /** Hourly "was a credit missed?" notifications. */
+    val remindersEnabled: Boolean = true,
+    /** Smallest card spend we ask about; 0 = every spend. */
+    val askMinAmount: Int = 5000,
+    /** Hours either side of a card spend in which a bank credit is a candidate match. */
+    val windowHours: Int = 24,
+)
+
+private data class Inputs(
+    val all: List<TransactionEntity>,
+    val links: List<ManualLink>,
+    val dismissed: Set<Long>,
+    val askMin: Int,
+    val windowHours: Int,
+)
+
+@OptIn(FlowPreview::class)
+@HiltViewModel
+class CardRotationViewModel @Inject constructor(
+    private val transactionRepository: TransactionRepository,
+    private val accountBalanceRepository: AccountBalanceRepository,
+    private val addTransaction: AddTransactionUseCase,
+    @ApplicationContext context: Context,
+) : ViewModel() {
+
+    private val store = CardRotationStore(context)
+
+    // Confirmations live in SharedPreferences (not Room) so this feature needs no DB migration.
+    // Link format "outId:onwardId:T|E"; dismissed = set of card-spend ids. Not part of the app's backup.
+    private val links = MutableStateFlow(store.links())
+    private val dismissed = MutableStateFlow(store.dismissed())
+    private val askMin = MutableStateFlow(store.askMinAmount)
+    private val windowHours = MutableStateFlow(store.windowHours)
+
+    private val _uiState = MutableStateFlow(CardRotationUiState(remindersEnabled = store.remindersEnabled, askMinAmount = store.askMinAmount, windowHours = store.windowHours))
+    val uiState: StateFlow<CardRotationUiState> = _uiState.asStateFlow()
+
+    /** One-line confirmations ("Saved ₹10,000 credit · charges ₹500") shown as toasts by the screen. */
+    private val _messages = MutableSharedFlow<String>(extraBufferCapacity = 8)
+    val messages: SharedFlow<String> = _messages.asSharedFlow()
+
+    private fun inr(v: BigDecimal): String =
+        NumberFormat.getCurrencyInstance(Locale.Builder().setLanguage("en").setRegion("IN").build()).format(v)
+
+    init {
+        viewModelScope.launch {
+            accountBalanceRepository.getAllLatestBalances().collect { list ->
+                _uiState.update { it.copy(accounts = list.filter { a -> !a.isCreditCard }) }
+            }
+        }
+        viewModelScope.launch {
+            combine(transactionRepository.getAllTransactions(), links, dismissed, askMin, windowHours) { all, l, d, m, w -> Inputs(all, l, d, m, w) }
+                .debounce(300)
+                .collect { (all, l, d, m, w) ->
+                    val rows = all.filter { !it.isDeleted && it.currency == "INR" }
+                    val report = withContext(Dispatchers.Default) {
+                        CardRotation.analyze(rows.mapNotNull { it.toRotationTxn() }, links = l, dismissedOutIds = d, askMinAmount = BigDecimal(m),
+                            windowMinutes = w * 60L, onwardWindowMinutes = w * 60L)
+                    }
+                    val paired = report.pairedIds
+                    val hidden = paired.isNotEmpty() &&
+                        rows.filter { it.id in paired }.all { it.excludedFromAnalytics }
+                    _uiState.update { it.copy(report = report, rotationHidden = hidden, isLoading = false) }
+                }
+        }
+    }
+
+    fun setAskMinAmount(amount: Int) {
+        store.askMinAmount = amount
+        askMin.value = store.askMinAmount
+        _uiState.update { it.copy(askMinAmount = store.askMinAmount) }
+    }
+
+    fun setWindowHours(hours: Int) {
+        store.windowHours = hours
+        windowHours.value = store.windowHours
+        _uiState.update { it.copy(windowHours = store.windowHours) }
+    }
+
+    fun setRemindersEnabled(enabled: Boolean) {
+        store.remindersEnabled = enabled
+        _uiState.update { it.copy(remindersEnabled = enabled) }
+    }
+
+    /** Flags every detected rotation row as excluded from income/expense totals. Reversible. */
+    fun setRotationHidden(hide: Boolean) {
+        val paired = _uiState.value.report?.pairedIds ?: return
+        setExcluded(paired, hide)
+    }
+
+    /** The credit SMS was missing: the user says this card spend and that bank debit belong together. */
+    fun confirmSuggestion(s: RotationSuggestion, use: OnwardUse) {
+        saveLinks(links.value.filter { it.outId != s.outId } + ManualLink(s.outId, s.onwardId, use))
+        setExcluded(if (use == OnwardUse.TRANSFER) setOf(s.outId, s.onwardId) else setOf(s.outId), true)
+        _messages.tryEmit("Linked. Estimated charges ${inr(s.estCharges)}")
+    }
+
+    fun dismissSuggestion(outId: Long) {
+        saveDismissed(dismissed.value + outId)
+        _messages.tryEmit("Okay, I won't ask about that spend again")
+    }
+
+    /** Undo a confirmed link and put its rows back into the totals. */
+    fun unlink(p: RotationPair) {
+        saveLinks(links.value.filter { it.outId != p.outId })
+        setExcluded(setOfNotNull(p.outId, p.inId, p.onwardId), false)
+        _messages.tryEmit("Unlinked")
+    }
+
+    /**
+     * "Yes, a credit was missed": the user enters what actually arrived (e.g. 10,000 against a 10,500 card
+     * spend). It is saved as a real income row on the chosen account, so balances stay right, and both rows
+     * are excluded from income/expense totals. The difference is the rotation charge.
+     * Returns false (and saves nothing) when the amount is not between 0 and the card spend.
+     */
+    fun addMissingCredit(outId: Long, spent: BigDecimal, at: LocalDateTime, credited: BigDecimal, account: AccountBalanceEntity?): Boolean {
+        if (credited.signum() <= 0 || credited > spent) return false
+        viewModelScope.launch {
+            val date = at.plusMinutes(1)
+            try {
+            addTransaction.execute(
+                amount = credited,
+                merchant = CardRotation.MANUAL_CREDIT_MERCHANT,
+                category = "Others",
+                type = TransactionType.INCOME,
+                date = date,
+                notes = "Credit entered by hand for card spend #$outId",
+                bankName = account?.bankName,
+                accountLast4 = account?.accountLast4,
+            )
+            // Found by the note naming this exact spend (not by timestamp, which can shift in storage).
+            val created = transactionRepository.getAllTransactions().first().firstOrNull {
+                it.merchantName == CardRotation.MANUAL_CREDIT_MERCHANT && it.description?.contains("card spend #$outId") == true
+            }
+            excludeNow(setOfNotNull(outId, created?.id), true)
+            _messages.tryEmit("Saved ${inr(credited)} credit. Charges ${inr(spent - credited)}")
+            } catch (e: Exception) {
+                _messages.tryEmit("Could not save the credit: ${e.message ?: "unknown error"}")
+            }
+        }
+        return true
+    }
+
+    private fun setExcluded(ids: Set<Long>, excluded: Boolean) {
+        viewModelScope.launch { excludeNow(ids, excluded) }
+    }
+
+    private suspend fun excludeNow(ids: Set<Long>, excluded: Boolean) {
+        val now = LocalDateTime.now()
+        transactionRepository.getAllTransactions().first()
+            .filter { it.id in ids && it.excludedFromAnalytics != excluded }
+            .forEach { transactionRepository.updateTransaction(it.copy(excludedFromAnalytics = excluded, updatedAt = now)) }
+    }
+
+    private fun saveLinks(v: List<ManualLink>) {
+        links.value = v
+        store.saveLinks(v)
+    }
+
+    private fun saveDismissed(v: Set<Long>) {
+        dismissed.value = v
+        store.saveDismissed(v)
+    }
+}
