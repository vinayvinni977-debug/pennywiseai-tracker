+@Composable
+private fun QuestionCard(q: PaymentQuestion, report: PaymentsReport, onDuplicate: () -> Unit, onKeep: () -> Unit, onReverse: () -> Unit) {
+    val row = report.allRows.firstOrNull { it.txn.id == q.txnId }
+    Card(Modifier.fillMaxWidth()) {
+        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+            when (q) {
+                is PaymentQuestion.PossibleDuplicate -> {
+                    val other = report.allRows.firstOrNull { it.txn.id == q.otherTxnId }
+                    Text("Are these the same payment?", fontWeight = FontWeight.SemiBold)
+                    Text("${row?.txn?.let { money(it.amount) + " · " + it.dateTime.format(whenFmt) } ?: "?"}", style = MaterialTheme.typography.bodyMedium)
+                    Text("${other?.txn?.let { money(it.amount) + " · " + it.dateTime.format(whenFmt) } ?: "?"}", style = MaterialTheme.typography.bodyMedium)
+                    Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                        Button(onClick = onDuplicate) { Text("Same, ignore the first") }
+                        OutlinedButton(onClick = onKeep) { Text("Different payments") }
+                    }
+                }
+                is PaymentQuestion.PossibleReversal -> {
+                    Text("Was this payment reversed?", fontWeight = FontWeight.SemiBold)
+                    Text("${row?.txn?.let { money(it.amount) + " paid " + it.dateTime.format(whenFmt) } ?: "?"}", style = MaterialTheme.typography.bodyMedium)
+                    Text("A credit of the same amount arrived on ${q.creditAt.format(whenFmt)}. It does not say it is a reversal.", style = MaterialTheme.typography.bodySmall)
+                    Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                        Button(onClick = onReverse) { Text("Yes, reversed") }
+                        OutlinedButton(onClick = onKeep) { Text("No, keep it") }
+                    }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun CardPaymentsBlock(
+    c: CardPaymentSummary, open: Boolean, onToggle: () -> Unit,
+    onReconcile: () -> Unit, onSchedule: () -> Unit, onUnassign: (Long) -> Unit,
+) {
+    val o = c.outstanding
+    Card(Modifier.fillMaxWidth()) {
+        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+            Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
+                Text(c.card.label, style = MaterialTheme.typography.titleMedium, fontWeight = FontWeight.SemiBold)
+                when {
+                    c.paidInFull -> Text("Paid in full", style = MaterialTheme.typography.bodyMedium)
+                    c.partiallyPaid -> Text("Partly paid", style = MaterialTheme.typography.bodyMedium)
+                }
+            }
+            Line("Outstanding", money(o.amount.max(BigDecimal.ZERO)), emphasize = true)
+            Text(
+                when (o.anchorKind) {
+                    AnchorKind.RECONCILED -> "Your figure from ${o.anchorAt?.format(whenFmt)}, plus later spends, minus later confirmed payments."
+                    AnchorKind.BANK_SMS -> "The bank's figure from ${o.anchorAt?.format(whenFmt)}, plus later spends, minus later confirmed payments."
+                    AnchorKind.NONE -> "Estimate only. No bank figure yet, so this is built from the history PennyWise has. Reconcile to fix it."
+                },
+                style = MaterialTheme.typography.bodySmall,
+            )
+            c.limit?.let { Line("Credit limit", money(it)) }
+            Line("Paid this month", money(c.paidMonth))
+            Line("Paid, all time", money(c.paidAll))
+            Line("Next due", c.nextDue?.format(dateFmt) ?: "Not set")
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                OutlinedButton(onClick = onReconcile) { Text("Reconcile") }
+                OutlinedButton(onClick = onSchedule) { Text("Due date & reminders") }
+            }
+            TextButton(onClick = onToggle) { Text(if (open) "Hide history" else "Show history") }
+            if (open) {
+                if (c.payments.isEmpty()) Text("No payments recorded for this card yet.", style = MaterialTheme.typography.bodySmall)
+                c.payments.forEach { r ->
+                    Column(Modifier.fillMaxWidth(), verticalArrangement = Arrangement.spacedBy(2.dp)) {
+                        Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
+                            Text("${statusLabel(r.status)} · ${r.txn.dateTime.format(whenFmt)}", style = MaterialTheme.typography.bodyMedium)
+                            Text(money(r.amount ?: r.txn.amount), style = MaterialTheme.typography.bodyMedium)
+                        }
+                        Text(r.note, style = MaterialTheme.typography.bodySmall)
+                        r.history.forEach { e -> Text("• ${e.at.format(whenFmt)}: ${statusLabel(e.status)}${e.amount?.let { " ${money(it)}" }.orEmpty()}. ${e.note}", style = MaterialTheme.typography.bodySmall) }
+                        if (r.status == PaymentStatus.CONFIRMED && r.basis != PaymentRow.Basis.NONE) {
+                            TextButton(onClick = { onUnassign(r.txn.id) }) { Text("Undo, move back to waiting") }
+                        }
+                    }
+                    HorizontalDivider()
+                }
+                if (c.reconciliations.isNotEmpty()) {
+                    Text("Reconciliations", fontWeight = FontWeight.SemiBold)
+                    c.reconciliations.forEach { r ->
+                        Text("${r.at.format(whenFmt)}: bank said ${money(r.bankOutstanding)}, PennyWise had ${money(r.calculatedBefore)} (difference ${money(r.difference)})", style = MaterialTheme.typography.bodySmall)
+                    }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun Line(label: String, value: String, emphasize: Boolean = false) {
+    Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
+        Text(label, style = MaterialTheme.typography.bodyMedium)
+        Text(value, style = MaterialTheme.typography.bodyMedium, fontWeight = if (emphasize) FontWeight.SemiBold else FontWeight.Normal)
+    }
+}
+
+/** Step 1: choose the card (and the amount, for a partial payment). Step 2: see exactly what will change, then confirm. */
+@Composable
+private fun ConfirmPaymentDialog(
+    row: PaymentRow, report: PaymentsReport?,
+    preview: (CardKey, BigDecimal) -> com.pennywiseai.tracker.domain.rotation.PaymentPreview?,
+    onConfirm: (CardKey, BigDecimal) -> Unit, onDismiss: () -> Unit,
+) {
+    val cards = report?.cards?.map { it.card }.orEmpty()
+    // CRED never pre-selects a card; other payments pre-select a card only when its full last four digits are in the SMS.
+    var chosen by remember { mutableStateOf<CardKey?>(if (row.evidence == PaymentEvidence.CRED) null else row.suggestedCard) }
+    var amountText by remember { mutableStateOf(row.txn.amount.toPlainString()) }
+    var step by remember { mutableStateOf(1) }
+    val amount = amountText.replace(",", "").toBigDecimalOrNull()
+    val pv = if (chosen != null && amount != null) preview(chosen!!, amount) else null
+    val summary = chosen?.let { c -> report?.cards?.firstOrNull { CardPayments.id(it.card) == CardPayments.id(c) } }
+
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text(if (step == 1) "Which card did you pay?" else "Check, then confirm") },
+        text = {
+            Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                Text("${money(row.txn.amount)} · ${row.txn.merchant} · ${row.txn.dateTime.format(whenFmt)}", style = MaterialTheme.typography.bodyMedium)
+                if (step == 1) {
+                    if (cards.isEmpty()) Text("No cards found yet.")
+                    cards.forEach { c ->
+                        Row(Modifier.fillMaxWidth().clickable { chosen = c }, verticalAlignment = Alignment.CenterVertically) {
+                            RadioButton(selected = chosen?.let { CardPayments.id(it) } == CardPayments.id(c), onClick = { chosen = c })
+                            Text(c.label)
+                        }
+                    }
+                    OutlinedTextField(
+                        value = amountText, onValueChange = { amountText = it }, singleLine = true,
+                        label = { Text("Amount to count for this card") },
+                        supportingText = { Text("Less than the debit for a partial payment. At most ${money(row.txn.amount)}.") },
+                        isError = amount == null || (chosen != null && pv == null),
+                        keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Decimal),
+                    )
+                } else if (pv != null) {
+                    Line("Payment amount", money(pv.paymentAmount))
+                    Line("Card", pv.card.label)
+                    Line("Current outstanding", money(pv.currentOutstanding.max(BigDecimal.ZERO)))
+                    Line("Outstanding after", money(pv.projectedOutstanding.max(BigDecimal.ZERO)), emphasize = true)
+                    if (pv.overpays) Text("This is more than the outstanding amount PennyWise has for this card.", style = MaterialTheme.typography.bodySmall)
+                    if (pv.unallocated.signum() > 0) Text("${money(pv.unallocated)} of the debit is not counted for this card.", style = MaterialTheme.typography.bodySmall)
+                    if (summary?.outstanding?.isEstimate == true) Text("The current outstanding is an estimate. Reconcile with your bank's figure for an exact one.", style = MaterialTheme.typography.bodySmall)
+                    Text("Nothing changes until you confirm.", style = MaterialTheme.typography.bodySmall)
+                }
+            }
+        },
+        confirmButton = {
+            if (step == 1) Button(enabled = pv != null, onClick = { step = 2 }) { Text("Next") }
+            else Button(onClick = { onConfirm(chosen!!, amount!!) }) { Text("Confirm payment") }
+        },
+        dismissButton = {
+            if (step == 2) TextButton(onClick = { step = 1 }) { Text("Back") } else TextButton(onClick = onDismiss) { Text("Cancel") }
+        },
+    )
+}
+
+@Composable
+private fun ReconcileDialog(s: CardPaymentSummary, onSave: (BigDecimal) -> Unit, onDismiss: () -> Unit) {
+    var text by remember { mutableStateOf("") }
+    val bank = text.replace(",", "").toBigDecimalOrNull()?.takeIf { it.signum() >= 0 }
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text("Reconcile ${s.card.label}") },
+        text = {
+            Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                Text("PennyWise calculates ${money(s.outstanding.amount.max(BigDecimal.ZERO))}${if (s.outstanding.isEstimate) " (estimate)" else ""}.")
+                OutlinedTextField(
+                    value = text, onValueChange = { text = it }, singleLine = true,
+                    label = { Text("Outstanding shown by your bank") },
+                    supportingText = { if (bank != null) Text("Difference: ${money(bank - s.outstanding.amount)}") },
+                    keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Decimal),
+                )
+                Text("This records a checkpoint. No transactions are added or changed, and earlier checkpoints are kept.", style = MaterialTheme.typography.bodySmall)
+            }
+        },
+        confirmButton = { Button(enabled = bank != null, onClick = { onSave(bank!!) }) { Text("Save") } },
+        dismissButton = { TextButton(onClick = onDismiss) { Text("Cancel") } },
+    )
+}
+
+@Composable
+private fun ScheduleDialog(s: CardPaymentSummary, onSave: (CardSchedule) -> Unit, onDismiss: () -> Unit) {
+    val cur = s.schedule
+    var dueDay by remember { mutableStateOf(cur?.dueDay?.toString().orEmpty()) }
+    var before by remember { mutableStateOf((cur?.remindDaysBefore ?: listOf(3, 1)).joinToString(", ")) }
+    var onDue by remember { mutableStateOf(cur?.remindOnDue ?: true) }
+    var overdue by remember { mutableStateOf(cur?.overdueAlerts ?: true) }
+    val day = dueDay.toIntOrNull()?.takeIf { it in 1..31 }
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text("${s.card.label}: due date") },
+        text = {
+            Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                OutlinedTextField(
+                    value = dueDay, onValueChange = { dueDay = it.filter { c -> c.isDigit() }.take(2) }, singleLine = true,
+                    label = { Text("Bill is due on day of month (1-31)") },
+                    isError = dueDay.isNotEmpty() && day == null,
+                    keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+                )
+                OutlinedTextField(
+                    value = before, onValueChange = { before = it }, singleLine = true,
+                    label = { Text("Remind me this many days before") },
+                    supportingText = { Text("For example 5, 2, 1. Leave empty for none.") },
+                )
+                Row(verticalAlignment = Alignment.CenterVertically) { Text("Remind me on the due date", Modifier.weight(1f)); Switch(checked = onDue, onCheckedChange = { onDue = it }) }
+                Row(verticalAlignment = Alignment.CenterVertically) { Text("Alert me when overdue", Modifier.weight(1f)); Switch(checked = overdue, onCheckedChange = { overdue = it }) }
+                Text("A partial payment lowers the amount but does not mark the bill as paid. PennyWise never guesses a due date.", style = MaterialTheme.typography.bodySmall)
+            }
+        },
+        confirmButton = {
+            Button(enabled = dueDay.isEmpty() || day != null, onClick = {
+                val days = before.split(",", " ").mapNotNull { it.trim().toIntOrNull() }.filter { it in 1..31 }.distinct()
+                onSave(CardSchedule(s.card, day, days, onDue, overdue))
+            }) { Text("Save") }
+        },
+        dismissButton = { TextButton(onClick = onDismiss) { Text("Cancel") } },
+    )
+}
